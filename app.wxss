/* 全局样式 - 设计令牌系统 */
page {
  /* 主色调 */
  --color-primary: #2563eb;
  --color-primary-dark: #1d4ed8;
  --color-primary-light: #3b82f6;
  --color-accent: #10b981;
  --color-accent-dark: #059669;

  /* 涨跌色 */
  --color-rise: #ef4444;
  --color-fall: #10b981;
  --color-rise-light: rgba(239, 68, 68, 0.1);
  --color-fall-light: rgba(16, 185, 129, 0.1);

  /* 背景色 */
  --color-bg-page: #f8fafc;
  --color-bg-section: #f1f5f9;
  --color-bg-card: #ffffff;

  /* 文字色 */
  --color-text: #1e293b;
  --color-text-secondary: #475569;
  --color-text-light: #64748b;
  --color-text-lighter: #94a3b8;
  --color-text-muted: #cbd5e1;

  /* 边框色 */
  --color-border: #e2e8f0;
  --color-border-light: #f1f5f9;

  /* 间距系统 - rpx单位 */
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 20rpx;
  --space-xl: 24rpx;
  --space-2xl: 32rpx;
  --space-3xl: 40rpx;

  /* 圆角系统 */
  --radius-sm: 6rpx;
  --radius-md: 10rpx;
  --radius-lg: 14rpx;
  --radius-xl: 20rpx;
  --radius-2xl: 28rpx;
  --radius-full: 9999rpx;

  /* 阴影系统 */
  --shadow-sm: 0 1rpx 3rpx rgba(0,0,0,0.04), 0 1rpx 2rpx rgba(0,0,0,0.06);
  --shadow-md: 0 4rpx 12rpx rgba(0,0,0,0.08), 0 2rpx 4rpx rgba(0,0,0,0.06);
  --shadow-lg: 0 10rpx 25rpx rgba(0,0,0,0.1), 0 4rpx 6rpx rgba(0,0,0,0.05);

  /* 字体 */
  --font-normal: 400;
  --font-medium: 500;
  --font-semibold: 600;
  --font-bold: 700;

  /* 字体大小 */
  --text-xs: 20rpx;
  --text-sm: 22rpx;
  --text-base: 24rpx;
  --text-lg: 28rpx;
  --text-xl: 32rpx;
  --text-2xl: 36rpx;
  --text-3xl: 40rpx;
  --text-4xl: 48rpx;

  /* 页面背景 */
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: var(--color-text);
  font-size: var(--text-base);
  line-height: 1.5;
}

/* 通用容器 */
.container {
  padding: var(--space-md);
  padding-bottom: calc(var(--space-md) + 120rpx);
}

/* 卡片样式 */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  margin-bottom: var(--space-md);
  overflow: hidden;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-md) var(--space-lg);
  border-bottom: 1rpx solid var(--color-border-light);
}

.card-title {
  font-size: var(--text-lg);
  font-weight: var(--font-semibold);
  color: var(--color-text);
}

.card-body {
  padding: var(--space-lg);
}

/* 渐变按钮 */
.btn-gradient {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  color: white;
  border-radius: var(--radius-lg);
  padding: var(--space-md) var(--space-xl);
  font-weight: var(--font-semibold);
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.3);
  transition: all 0.3s ease;
}

.btn-gradient:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(37, 99, 235, 0.2);
}

/* 上升下降样式 */
.rise {
  color: var(--color-rise);
}

.fall {
  color: var(--color-fall);
}

/* 标签样式 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  font-size: var(--text-xs);
  font-weight: var(--font-medium);
  border-radius: var(--radius-sm);
}

.tag-primary {
  background: rgba(37, 99, 235, 0.1);
  color: var(--color-primary);
}

.tag-success {
  background: rgba(16, 185, 129, 0.1);
  color: var(--color-accent);
}

.tag-warning {
  background: rgba(245, 158, 11, 0.1);
  color: #d97706;
}

/* Flex布局工具类 */
.flex {
  display: flex;
}

.flex-col {
  flex-direction: column;
}

.items-center {
  align-items: center;
}

.justify-between {
  justify-content: space-between;
}

.justify-center {
  justify-content: center;
}

.flex-1 {
  flex: 1;
}

/* 间距工具类 */
.mt-sm { margin-top: var(--space-sm); }
.mt-md { margin-top: var(--space-md); }
.mt-lg { margin-top: var(--space-lg); }
.mb-sm { margin-bottom: var(--space-sm); }
.mb-md { margin-bottom: var(--space-md); }
.mb-lg { margin-bottom: var(--space-lg); }
.ml-sm { margin-left: var(--space-sm); }
.mr-sm { margin-right: var(--space-sm); }

/* 文字工具类 */
.text-xs { font-size: var(--text-xs); }
.text-sm { font-size: var(--text-sm); }
.text-lg { font-size: var(--text-lg); }
.text-xl { font-size: var(--text-xl); }
.text-2xl { font-size: var(--text-2xl); }

.font-medium { font-weight: var(--font-medium); }
.font-semibold { font-weight: var(--font-semibold); }
.font-bold { font-weight: var(--font-bold); }

.text-light { color: var(--color-text-light); }
.text-lighter { color: var(--color-text-lighter); }
.text-primary { color: var(--color-primary); }

/* 隐藏滚动条但保留滚动 */
.scroll-hide::-webkit-scrollbar {
  display: none;
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

@keyframes live-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(0.95); }
}

.animate-fadeIn {
  animation: fadeIn 0.3s ease;
}

.animate-pulse {
  animation: pulse 2s ease-in-out infinite;
}
