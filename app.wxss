/* 全局样式 - 基于 jicai-fixed.html 设计系统 */

page {
  /* 主色调 */
  --color-primary: #2563eb;
  --color-primary-dark: #1d4ed8;
  --color-primary-light: #dbeafe;
  --color-accent: #10b981;
  --color-accent-light: #d1fae5;

  /* 背景色 */
  --color-bg-page: #f8fafc;
  --color-bg-section: #f1f5f9;
  --color-bg-card: #ffffff;

  /* 文字色 */
  --color-text: #1e293b;
  --color-text-secondary: #475569;
  --color-text-light: #64748b;
  --color-text-lighter: #94a3b8;
  --color-text-muted: #cbd5e1;

  /* 功能色 */
  --color-rise: #ef4444;
  --color-rise-bg: rgba(239, 68, 68, 0.1);
  --color-fall: #10b981;
  --color-fall-bg: rgba(16, 185, 129, 0.1);
  --color-warning: #f59e0b;
  --color-warning-bg: rgba(245, 158, 11, 0.1);
  --color-info: #3b82f6;
  --color-info-bg: rgba(59, 130, 246, 0.1);

  /* 边框色 */
  --color-border: #e2e8f0;
  --color-border-light: #f1f5f9;

  /* 间距系统 - rpx单位 */
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 20rpx;
  --space-xl: 24rpx;
  --space-2xl: 32rpx;

  /* 圆角系统 */
  --radius-sm: 6rpx;
  --radius-md: 10rpx;
  --radius-lg: 14rpx;
  --radius-xl: 18rpx;
  --radius-2xl: 24rpx;
  --radius-full: 9999rpx;

  /* 阴影系统 */
  --shadow-sm: 0 1rpx 3rpx rgba(0,0,0,0.04), 0 1rpx 2rpx rgba(0,0,0,0.06);
  --shadow-md: 0 4rpx 12rpx rgba(0,0,0,0.08), 0 2rpx 4rpx rgba(0,0,0,0.06);
  --shadow-lg: 0 10rpx 25rpx rgba(0,0,0,0.1), 0 6rpx 12rpx rgba(0,0,0,0.08);
  --shadow-xl: 0 20rpx 40rpx rgba(0,0,0,0.12), 0 10rpx 20rpx rgba(0,0,0,0.1);
  --shadow-glow: 0 0 20rpx rgba(37, 99, 235, 0.15);

  /* 字体大小 */
  --text-xs: 20rpx;
  --text-sm: 22rpx;
  --text-base: 24rpx;
  --text-lg: 28rpx;
  --text-xl: 30rpx;
  --text-2xl: 36rpx;
  --text-3xl: 40rpx;
  --text-4xl: 48rpx;

  /* 字体粗细 */
  --font-normal: 400;
  --font-medium: 500;
  --font-semibold: 600;
  --font-bold: 700;
  --font-extrabold: 800;

  /* 页面背景 */
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: var(--color-text);
  font-size: var(--text-sm);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* 通用容器 */
.container {
  padding-bottom: calc(var(--space-md) + 120rpx);
}

/* 卡片通用样式 */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

/* 涨跌样式 */
.rise {
  color: var(--color-rise);
}

.fall {
  color: var(--color-fall);
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

@keyframes live-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(0.95); }
}

.animate-fadeIn {
  animation: fadeIn 0.3s ease;
}

.animate-pulse {
  animation: pulse 2s ease-in-out infinite;
}
