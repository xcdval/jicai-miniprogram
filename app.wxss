/* ============================================
   集财小程序 - 设计系统
   主色调: 蓝 (#2563eb) + 绿 (#10b981)
   涨跌色: 红涨绿跌 (A股习惯)
   ============================================ */

page {
  /* 主色调 */
  --color-primary: #2563eb;
  --color-primary-dark: #1d4ed8;
  --color-primary-light: #dbeafe;
  --color-accent: #10b981;
  --color-accent-dark: #059669;
  --color-accent-light: #d1fae5;

  /* 渐变色 */
  --color-gradient: linear-gradient(135deg, #2563eb, #10b981);
  --color-gradient-hover: linear-gradient(135deg, #1d4ed8, #059669);
  --color-gradient-active: linear-gradient(135deg, #1e40af, #047857);

  /* 涨跌色 - 金融语义保留 (红涨绿跌) */
  --color-rise: #ef4444;
  --color-rise-bg: rgba(239, 68, 68, 0.1);
  --color-rise-light: #fecaca;
  --color-fall: #10b981;
  --color-fall-bg: rgba(16, 185, 129, 0.1);
  --color-fall-light: #a7f3d0;

  /* 功能色 */
  --color-warning: #f59e0b;
  --color-warning-bg: rgba(245, 158, 11, 0.1);
  --color-info: #3b82f6;
  --color-info-bg: rgba(59, 130, 246, 0.1);
  --color-success: #10b981;
  --color-success-bg: rgba(16, 185, 129, 0.1);

  /* 深色模式变量 */
  --color-dark-bg: #0f172a;
  --color-dark-card: #1e293b;
  --color-dark-border: #334155;
  --color-dark-text: #f1f5f9;
  --color-dark-text-secondary: #94a3b8;

  /* 背景色 */
  --color-bg-page: #f8fafc;
  --color-bg-section: #f1f5f9;
  --color-bg-card: #ffffff;

  /* 文字色 */
  --color-text: #1e293b;
  --color-text-secondary: #475569;
  --color-text-light: #64748B;
  --color-text-lighter: #94A3B8;
  --color-text-muted: #CBD5E1;

  /* 边框色 */
  --color-border: #E2E8F0;
  --color-border-light: #F1F5F9;

  /* 间距系统 - rpx单位 */
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 20rpx;
  --space-xl: 24rpx;
  --space-2xl: 32rpx;

  /* 圆角系统 */
  --radius-sm: 6rpx;
  --radius-md: 10rpx;
  --radius-lg: 14rpx;
  --radius-xl: 18rpx;
  --radius-2xl: 24rpx;
  --radius-full: 9999rpx;

  /* 阴影系统 */
  --shadow-sm: 0 1rpx 3rpx rgba(0,0,0,0.04), 0 1rpx 2rpx rgba(0,0,0,0.06);
  --shadow-md: 0 4rpx 12rpx rgba(0,0,0,0.08), 0 2rpx 4rpx rgba(0,0,0,0.06);
  --shadow-lg: 0 10rpx 25rpx rgba(0,0,0,0.1), 0 6rpx 12rpx rgba(0,0,0,0.08);
  --shadow-xl: 0 20rpx 40rpx rgba(0,0,0,0.12), 0 10rpx 20rpx rgba(0,0,0,0.1);
  --shadow-glow: 0 0 20rpx rgba(139, 92, 246, 0.2);

  /* 字体大小 */
  --text-xs: 20rpx;
  --text-sm: 22rpx;
  --text-base: 24rpx;
  --text-lg: 28rpx;
  --text-xl: 30rpx;
  --text-2xl: 36rpx;
  --text-3xl: 40rpx;
  --text-4xl: 48rpx;

  /* 字体粗细 */
  --font-normal: 400;
  --font-medium: 500;
  --font-semibold: 600;
  --font-bold: 700;
  --font-extrabold: 800;

  /* 页面背景 */
  background: var(--color-bg-page);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: var(--color-text);
  font-size: var(--text-sm);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ============================================
   动画关键帧
   ============================================ */

/* 骨架屏闪烁动画 */
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 页面进入动画 */
@keyframes pageEnter {
  from { opacity: 0; transform: translateX(40rpx); }
  to { opacity: 1; transform: translateX(0); }
}

/* 列表项淡入上移动画 */
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 脉冲动画 */
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 浮动动画 */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

/* 旋转动画 */
@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 缩放脉冲 */
@keyframes scalePulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(0.95); }
}

/* 原有动画兼容 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes live-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(0.95); }
}

/* ============================================
   通用类
   ============================================ */

/* 通用容器 */
.container {
  padding-bottom: calc(var(--space-md) + 120rpx);
}

/* 卡片通用样式 */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

/* 渐变按钮 */
.btn-primary {
  background: var(--color-gradient);
  color: #ffffff;
  border: none;
  border-radius: var(--radius-lg);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.btn-primary:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-glow);
  background: var(--color-gradient-hover);
}

/* 次级按钮 */
.btn-secondary {
  background: transparent;
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  border-radius: var(--radius-lg);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.btn-secondary:active {
  background: var(--color-primary-light);
  transform: scale(0.98);
}

/* 禁用按钮 */
.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 卡片悬停效果 */
.card-hover {
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.card-hover:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

/* 骨架屏基础样式 */
.skeleton {
  background: linear-gradient(
    90deg,
    var(--color-bg-section) 25%,
    var(--color-bg-card) 50%,
    var(--color-bg-section) 75%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: var(--radius-md);
}

/* 骨架屏卡片 */
.skeleton-card {
  height: 200rpx;
  margin: 24rpx 32rpx;
}

/* 骨架屏文本行 */
.skeleton-text {
  height: 32rpx;
  margin-bottom: 16rpx;
}

.skeleton-text.short {
  width: 60%;
}

/* 页面进入动画类 */
.page-enter {
  animation: pageEnter 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 列表项动画类 */
.list-item {
  animation: fadeSlideUp 0.3s ease forwards;
}

/* 涨跌样式 - 金融语义保留 */
.rise {
  color: var(--color-rise);
}

.fall {
  color: var(--color-fall);
}

/* 动画类 */
.animate-fadeIn {
  animation: fadeIn 0.3s ease;
}

.animate-pulse {
  animation: pulse 2s ease-in-out infinite;
}

.animate-float {
  animation: float 3s ease-in-out infinite;
}

.animate-rotate {
  animation: rotate 1s linear infinite;
}

/* 深色模式支持 */
[data-theme="dark"] {
  --color-bg-page: var(--color-dark-bg);
  --color-bg-section: #1E293B;
  --color-bg-card: var(--color-dark-card);
  --color-text: var(--color-dark-text);
  --color-text-secondary: var(--color-dark-text-secondary);
  --color-border: var(--color-dark-border);
}

/* SVG图标容器 */
.icon {
  width: 48rpx;
  height: 48rpx;
  display: inline-block;
}

.icon-sm {
  width: 32rpx;
  height: 32rpx;
}

.icon-lg {
  width: 64rpx;
  height: 64rpx;
}

/* 点击态反馈 */
.clickable {
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

.clickable:active {
  opacity: 0.8;
  transform: scale(0.98);
}
