<view class="news-flash-card">
  <view class="news-flash-header">
    <view class="news-flash-title">
      <text class="news-flash-icon">⚡</text>
      <text>财经热点</text>
      <view class="news-live-badge">LIVE</view>
    </view>
    <view class="news-flash-filter">
      <text
        class="news-filter-item {{activeFilter === item.value ? 'active' : ''}}"
        wx:for="{{filters}}"
        wx:key="value"
        data-filter="{{item.value}}"
        bindtap="onFilterTap"
      >{{item.label}}</text>
    </view>
  </view>

  <view class="news-timeline">
    <view
      class="news-item {{item.category}}"
      wx:for="{{filteredNews}}"
      wx:key="id"
      data-id="{{item.id}}"
    >
      <view class="news-item-indicator">
        <view class="news-time-col">
          <text class="news-time">{{item.time}}</text>
          <view class="news-relevance {{item.relevance}}">{{item.relevanceText || '一般'}}</view>
        </view>
        <view class="news-dot {{item.isHot ? 'hot' : ''}}">
          <view class="news-dot-inner" wx:if="{{item.isHot}}"></view>
        </view>
      </view>
      <view class="news-item-content">
        <view class="news-title-row">
          <text class="news-hot-tag" wx:if="{{item.isHot}}">🔥</text>
          <text class="news-category-tag {{item.category}}">{{item.categoryText}}</text>
          <text class="news-title {{item.isHot ? 'hot' : ''}} {{item.isPin ? 'pin' : ''}}">{{item.title}}</text>
        </view>
        <view class="news-meta">
          <text class="news-source">{{item.source}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="news-flash-footer">
    <view class="news-view-more" bindtap="onViewMore">
      查看更多快讯
      <text class="news-arrow">→</text>
    </view>
  </view>
</view>