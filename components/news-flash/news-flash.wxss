.news-flash-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(248, 250, 252, 0.95) 100%);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.news-flash-header {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}

.news-flash-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.news-flash-icon {
  font-size: 36rpx;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.news-live-badge {
  background: linear-gradient(135deg, #ef4444, #dc2626);
  color: white;
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 8rpx;
  animation: live-pulse 1.5s ease-in-out infinite;
}

@keyframes live-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(0.95); }
}

.news-flash-filter {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.news-filter-item {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #64748b;
  background: rgba(226, 232, 240, 0.5);
  border-radius: 9999rpx;
  transition: all 0.3s ease;
}

.news-filter-item.active {
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  color: #ffffff;
}

.news-timeline {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.news-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.4);
  animation: fadeIn 0.3s ease;
}

.news-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 左侧时间点和相关性 */
.news-item-indicator {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  width: 100rpx;
}

.news-time-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.news-time {
  font-size: 22rpx;
  font-weight: 600;
  color: #64748b;
  font-family: 'Courier New', monospace;
}

.news-relevance {
  font-size: 16rpx;
  font-weight: 600;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background: rgba(100, 116, 139, 0.1);
  color: #94a3b8;
}

.news-relevance.high {
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
}

.news-relevance.medium {
  background: rgba(245, 158, 11, 0.15);
  color: #f59e0b;
}

.news-relevance.low {
  background: rgba(16, 185, 129, 0.15);
  color: #10b981;
}

.news-relevance.normal {
  background: rgba(100, 116, 139, 0.1);
  color: #94a3b8;
}

/* 时间线点 */
.news-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e2e8f0;
  border: 3rpx solid #e2e8f0;
  position: relative;
}

.news-dot.hot {
  background: #ef4444;
  border-color: #ef4444;
  box-shadow: 0 0 8rpx rgba(239, 68, 68, 0.4);
}

.news-dot-inner {
  position: absolute;
  inset: -4rpx;
  border-radius: 50%;
  background: rgba(239, 68, 68, 0.3);
  animation: ripple 1.5s ease-out infinite;
}

@keyframes ripple {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(2); opacity: 0; }
}

/* 右侧内容 */
.news-item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.news-title-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex-wrap: wrap;
}

.news-hot-tag {
  font-size: 24rpx;
  flex-shrink: 0;
}

.news-category-tag {
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  text-transform: uppercase;
}

.news-category-tag.policy {
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
}

.news-category-tag.market {
  background: rgba(245, 158, 11, 0.15);
  color: #d97706;
}

.news-category-tag.tech {
  background: rgba(139, 92, 246, 0.15);
  color: #7c3aed;
}

.news-category-tag.global {
  background: rgba(59, 130, 246, 0.15);
  color: #3b82f6;
}

.news-category-tag.company {
  background: rgba(16, 185, 129, 0.15);
  color: #059669;
}

.news-category-tag.macro {
  background: rgba(236, 72, 153, 0.15);
  color: #db2777;
}

.news-category-tag.general {
  background: rgba(100, 116, 139, 0.15);
  color: #64748b;
}

.news-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #64748b;
  line-height: 1.4;
}

.news-title.hot {
  color: #ef4444;
  font-weight: 700;
}

.news-title.pin {
  color: #1e293b;
  font-weight: 700;
}

.news-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #475569;
}

.news-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 4rpx;
}

.news-source {
  font-size: 20rpx;
  color: #94a3b8;
}

.news-hot {
  font-size: 20rpx;
  color: #ef4444;
  font-weight: 700;
}

.news-stock {
  font-size: 20rpx;
  color: #10b981;
  font-weight: 600;
}

.news-flash-footer {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(226, 232, 240, 0.6);
  display: flex;
  justify-content: center;
}

.news-view-more {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #2563eb;
  background: rgba(37, 99, 235, 0.08);
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.news-arrow {
  transition: transform 0.3s ease;
}

.news-view-more:active .news-arrow {
  transform: translateX(8rpx);
}

/* 保留原有样式兼容性 */
.news-item-time {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.news-tag {
  padding: 4rpx 10rpx;
  font-size: 18rpx;
  font-weight: 700;
  border-radius: 6rpx;
  text-transform: uppercase;
}

.news-tag.market {
  background: rgba(245, 158, 11, 0.15);
  color: #d97706;
}

.news-tag.macro {
  background: rgba(139, 92, 246, 0.15);
  color: #7c3aed;
}

.news-tag.company {
  background: rgba(16, 185, 129, 0.15);
  color: #059669;
}
