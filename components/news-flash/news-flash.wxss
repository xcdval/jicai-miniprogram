
.news-flash-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(248, 250, 252, 0.95) 100%);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.news-flash-header {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}

.news-flash-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.news-flash-icon {
  font-size: 36rpx;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.news-live-badge {
  background: linear-gradient(135deg, #ef4444, #dc2626);
  color: white;
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 8rpx;
  animation: live-pulse 1.5s ease-in-out infinite;
}

@keyframes live-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(0.95); }
}

.news-flash-filter {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.news-filter-item {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #64748b;
  background: rgba(226, 232, 240, 0.5);
  border-radius: 9999rpx;
  transition: all 0.3s ease;
}

.news-filter-item.active {
  background: rgba(37, 99, 235, 0.15);
  color: #2563eb;
}

.news-timeline {
  position: relative;
  padding-left: 16rpx;
}

.news-timeline::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 2rpx;
  background: linear-gradient(180deg, rgba(37, 99, 235, 0.3), rgba(37, 99, 235, 0.1));
  border-radius: 1rpx;
}

.news-item {
  position: relative;
  padding-left: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.4);
  animation: fadeIn 0.3s ease;
}

.news-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.news-item::before {
  content: '';
  position: absolute;
  left: -10rpx;
  top: 12rpx;
  width: 18rpx;
  height: 18rpx;
  background: white;
  border: 3rpx solid #2563eb;
  border-radius: 50%;
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 1);
}

.news-item.market::before {
  border-color: #f59e0b;
}

.news-item.macro::before {
  border-color: #8b5cf6;
}

.news-item.company::before {
  border-color: #10b981;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.news-item-time {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.news-time {
  font-size: 22rpx;
  font-weight: 600;
  color: #64748b;
  font-family: 'Courier New', monospace;
}

.news-tag {
  padding: 4rpx 10rpx;
  font-size: 18rpx;
  font-weight: 700;
  border-radius: 6rpx;
  text-transform: uppercase;
}

.news-tag.market {
  background: rgba(245, 158, 11, 0.15);
  color: #d97706;
}

.news-tag.macro {
  background: rgba(139, 92, 246, 0.15);
  color: #7c3aed;
}

.news-tag.company {
  background: rgba(16, 185, 129, 0.15);
  color: #059669;
}

.news-item-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.news-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  line-height: 1.4;
}

.news-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #475569;
}

.news-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.news-source {
  font-size: 20rpx;
  color: #94a3b8;
}

.news-hot {
  font-size: 20rpx;
  color: #ef4444;
  font-weight: 700;
}

.news-stock {
  font-size: 20rpx;
  color: #10b981;
  font-weight: 600;
}

.news-flash-footer {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(226, 232, 240, 0.6);
  display: flex;
  justify-content: center;
}

.news-view-more {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #2563eb;
  background: rgba(37, 99, 235, 0.08);
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.news-arrow {
  transition: transform 0.3s ease;
}

.news-view-more:active .news-arrow {
  transform: translateX(8rpx);
}