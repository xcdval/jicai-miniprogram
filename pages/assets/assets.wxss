/* pages/assets/assets.wxss */
.nav-bar { display: flex; justify-content: space-between; align-items: center; padding: 0 32rpx; margin-bottom: 16rpx; }
.nav-title { font-size: 40rpx; font-weight: 700; color: #1e293b; }
.nav-actions { display: flex; gap: 24rpx; }
.nav-btn { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.8); border-radius: 16rpx; font-size: 32rpx; }

.asset-group-tabs { display: flex; gap: 16rpx; padding: 0 32rpx; margin-bottom: 24rpx; overflow-x: auto; }
.group-tab { padding: 16rpx 32rpx; font-size: 28rpx; font-weight: 500; color: #64748b; background: #f1f5f9; border-radius: 9999rpx; white-space: nowrap; transition: all 0.3s ease; }
.group-tab.active { background: linear-gradient(135deg, #2563eb, #1d4ed8); color: white; }

.asset-total-card { background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); border-radius: 32rpx; padding: 40rpx 32rpx; margin: 0 32rpx 24rpx; box-shadow: 0 8rpx 32rpx rgba(37,99,235,0.25); color: white; }
.asset-total-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.asset-total-label { font-size: 28rpx; opacity: 0.9; }
.eye-icon { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.2); border-radius: 16rpx; font-size: 28rpx; }
.asset-total-amount { font-size: 64rpx; font-weight: 700; margin-bottom: 32rpx; }
.asset-total-stats { display: flex; gap: 48rpx; }
.stat-item { display: flex; flex-direction: column; gap: 8rpx; }
.stat-label { font-size: 22rpx; opacity: 0.8; }
.stat-value { font-size: 32rpx; font-weight: 600; }
.stat-value.rise { color: #86efac; }
.stat-value.fall { color: #fecaca; }

.asset-category-list { padding: 0 32rpx; }
.asset-category-item { display: flex; align-items: center; gap: 20rpx; padding: 28rpx; background: white; border-radius: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.category-icon { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; font-size: 40rpx; }
.category-icon.fund { background: linear-gradient(135deg, #10b981, #059669); }
.category-icon.stock { background: linear-gradient(135deg, #f59e0b, #d97706); }
.category-icon.deposit { background: linear-gradient(135deg, #8b5cf6, #7c3aed); }
.category-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.category-name { font-size: 30rpx; font-weight: 600; color: #1e293b; }
.category-count { font-size: 22rpx; color: #94a3b8; }
.category-value { display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.category-amount { font-size: 30rpx; font-weight: 600; color: #1e293b; }
.category-change { font-size: 24rpx; font-weight: 500; }
.category-change.rise { color: #ef4444; }
.category-change.fall { color: #10b981; }