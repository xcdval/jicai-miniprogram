/* pages/funds/funds.wxss - 基于 jicai-fixed.html */

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  background: linear-gradient(90deg, rgba(37, 99, 235, 0.08) 0%, rgba(255, 255, 255, 0.8) 100%);
  font-size: 26rpx;
  font-weight: 500;
  color: #1e293b;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}

.status-time {
  font-weight: 600;
}

.status-dots {
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: rgba(255, 255, 255, 0.85);
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.5);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.nav-title {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
  background: linear-gradient(135deg, #2563eb, #10b981);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  border-radius: 9999rpx;
  font-size: 36rpx;
  color: #2563eb;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 搜索栏 */
.search-section {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: #ffffff;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #f1f5f9;
  border-radius: 9999rpx;
}

.search-icon {
  font-size: 28rpx;
  color: #94a3b8;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
}

.search-input::placeholder {
  color: #94a3b8;
}

.add-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 28rpx;
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  color: white;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 9999rpx;
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.25);
}

/* 分类标签 */
.sub-tabs {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}

.sub-tab {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #64748b;
  background: #f1f5f9;
  border-radius: 9999rpx;
  transition: all 0.3s ease;
}

.sub-tab.active {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  color: white;
}

/* 列表表头 */
.list-header {
  display: flex;
  padding: 20rpx 32rpx;
  background: #f8fafc;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}

.header-col {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 500;
  text-align: center;
}

.col-name {
  flex: 2;
  text-align: left;
}

.col-price,
.col-value,
.col-profit,
.col-today {
  flex: 1;
}

/* 基金列表 */
.fund-list {
  padding: 0 32rpx;
}

.fund-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.fund-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.fund-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #10b981, #059669);
  color: white;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 20rpx;
}

.fund-info {
  flex: 1;
}

.fund-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.fund-meta {
  font-size: 22rpx;
  color: #94a3b8;
}

.fund-data {
  display: flex;
  align-items: center;
}

.data-col {
  flex: 1;
  text-align: center;
}

.data-col.col-name {
  flex: 2;
  text-align: left;
}

.data-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 4rpx;
}

.data-sub {
  font-size: 22rpx;
  color: #94a3b8;
}

.data-value.rise,
.data-sub.rise {
  color: #ef4444;
}

.data-value.fall,
.data-sub.fall {
  color: #10b981;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #94a3b8;
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 9999rpx;
}

/* 汇总卡片 */
.summary-card {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-top: 1rpx solid rgba(226, 232, 240, 0.6);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.summary-item {
  text-align: center;
}

.summary-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.summary-value.rise {
  color: #ef4444;
}

.summary-value.fall {
  color: #10b981;
}
