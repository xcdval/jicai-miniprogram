.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
}

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  background: #ffffff;
}

.status-time {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.status-dots {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #1e293b;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f1f5f9;
}

.nav-btn {
  padding: 12rpx 20rpx;
  font-size: 48rpx;
  color: #2563eb;
  font-weight: 300;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.nav-btn:active {
  background: rgba(37, 99, 235, 0.1);
}

.nav-btn-placeholder {
  width: 80rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
}

/* 步骤内容区 */
.step-content {
  padding: 32rpx 24rpx;
  padding-bottom: 120rpx;
}

/* 步骤头 */
.step-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.step-number {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.3);
  flex-shrink: 0;
}

.step-info {
  flex: 1;
}

.step-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 4rpx;
}

.step-desc {
  font-size: 24rpx;
  color: #94a3b8;
}

/* 平台选择网格 */
.platform-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.platform-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 16rpx;
  background: #ffffff;
  border: 2rpx solid #e2e8f0;
  border-radius: 20rpx;
  position: relative;
  transition: all 0.25s ease;
}

.platform-card:active {
  transform: scale(0.97);
}

.platform-card.active {
  border-color: #2563eb;
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.15);
}

.platform-card-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 40rpx;
}

.platform-card-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  text-align: center;
}

.platform-card-check {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

/* 上传区域 */
.upload-zone {
  background: #ffffff;
  border: 2rpx dashed #cbd5e1;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
}

.upload-zone.active {
  border-color: #2563eb;
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.04) 0%, rgba(16, 185, 129, 0.04) 100%);
}

.upload-zone.active:active {
  transform: scale(0.99);
}

.upload-zone-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

.upload-illustration {
  font-size: 96rpx;
  margin-bottom: 20rpx;
  opacity: 0.8;
}

.upload-main-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.upload-sub-text {
  font-size: 24rpx;
  color: #94a3b8;
}

.upload-hint {
  font-size: 26rpx;
  color: #94a3b8;
}

.upload-decoration {
  position: absolute;
  bottom: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.08), rgba(16, 185, 129, 0.08));
  border-radius: 50%;
}

/* 小贴士卡片 */
.tips-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 32rpx;
  border-left: 4rpx solid #2563eb;
}

.tips-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.tips-icon {
  font-size: 28rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tips-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tips-num {
  font-size: 22rpx;
  font-weight: 700;
  color: #2563eb;
  background: rgba(37, 99, 235, 0.1);
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.tips-text {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.4;
}

/* 预览卡片 */
.preview-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 16rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.preview-image {
  width: 100%;
  max-height: 600rpx;
  border-radius: 12rpx;
}

/* 进度卡片 */
.progress-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.progress-visual {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

.progress-ring {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #e2e8f0, #f1f5f9);
  border-radius: 50%;
  overflow: hidden;
}

.progress-ring-fill {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 0;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  transition: width 0.4s ease;
  border-radius: 0 0 80rpx 80rpx;
}

.progress-percent {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 36rpx;
  font-weight: 700;
  color: #2563eb;
}

.progress-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.progress-tips {
  font-size: 24rpx;
  color: #94a3b8;
}

/* 结果列表 */
.result-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.result-card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.result-card.type-fund {
  border-left: 4rpx solid #2563eb;
}

.result-card.type-stock {
  border-left: 4rpx solid #10b981;
}

.result-card.type-deposit {
  border-left: 4rpx solid #f59e0b;
}

.result-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #f8fafc;
  border-bottom: 1rpx solid #f1f5f9;
}

.result-type-badge {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.result-type-badge.fund {
  background: rgba(37, 99, 235, 0.1);
  color: #2563eb;
}

.result-type-badge.stock {
  background: rgba(16, 185, 129, 0.1);
  color: #059669;
}

.result-type-badge.deposit {
  background: rgba(245, 158, 11, 0.1);
  color: #d97706;
}

.result-card-actions {
  display: flex;
  gap: 24rpx;
}

.result-action {
  font-size: 26rpx;
  font-weight: 500;
  padding: 6rpx 4rpx;
}

.result-action.edit {
  color: #2563eb;
}

.result-action.delete {
  color: #ef4444;
}

.result-card-body {
  padding: 20rpx 24rpx;
}

.result-main-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.result-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.result-code {
  font-size: 24rpx;
  color: #2563eb;
  background: rgba(37, 99, 235, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-family: 'SF Mono', 'Roboto Mono', monospace;
}

.result-detail-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.result-detail-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.result-detail-item.full {
  grid-column: span 2;
}

.detail-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.detail-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

/* 操作按钮组 */
.action-group {
  padding: 8rpx 0;
}

.btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-weight: 700;
  border-radius: 48rpx;
  border: none;
  transition: all 0.2s ease;
}

.btn-primary {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.35);
  margin-bottom: 16rpx;
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.25);
}

.btn-large {
  height: 100rpx;
  font-size: 32rpx;
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #64748b;
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}

/* 置信度指示条 */
.confidence-bar-container {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.confidence-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.confidence-text {
  font-size: 24rpx;
  color: #64748b;
}

.confidence-value {
  font-size: 26rpx;
  font-weight: 700;
}

.confidence-value.high {
  color: #10b981;
}

.confidence-value.medium {
  color: #f59e0b;
}

.confidence-value.low {
  color: #ef4444;
}

.confidence-bar {
  height: 10rpx;
  background: #e2e8f0;
  border-radius: 5rpx;
  overflow: hidden;
}

.confidence-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.4s ease;
}

.confidence-fill.high {
  background: linear-gradient(90deg, #10b981, #34d399);
}

.confidence-fill.medium {
  background: linear-gradient(90deg, #f59e0b, #fbbf24);
}

.confidence-fill.low {
  background: linear-gradient(90deg, #ef4444, #f87171);
}

/* 演示模式提示 */
.demo-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: rgba(245, 158, 11, 0.1);
  border: 1rpx solid rgba(245, 158, 11, 0.3);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.demo-icon {
  font-size: 28rpx;
}

.demo-text {
  font-size: 24rpx;
  color: #d97706;
  line-height: 1.4;
}

/* 手动输入步骤 */
.manual-tips-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-left: 4rpx solid #f59e0b;
}

.manual-input-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.manual-textarea {
  width: 100%;
  min-height: 280rpx;
  padding: 20rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1e293b;
  line-height: 1.8;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.manual-textarea:focus {
  border-color: #2563eb;
  background: #ffffff;
}

.manual-textarea::placeholder {
  color: #94a3b8;
  font-size: 26rpx;
}

.textarea-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.textarea-hint {
  font-size: 22rpx;
  color: #94a3b8;
  flex: 1;
}

.textarea-count {
  font-size: 22rpx;
  color: #94a3b8;
  flex-shrink: 0;
}
