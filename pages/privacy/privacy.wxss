/* pages/privacy/privacy.wxss */

.container {
  min-height: 100vh;
  background: #f5f6f8;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  background: #ffffff;
  font-size: 26rpx;
  color: #1e293b;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #1e293b;
}

.content {
  padding: 32rpx;
}

.policy-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.policy-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  text-align: center;
  margin-bottom: 16rpx;
}

.policy-date {
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
  margin-bottom: 40rpx;
}

.policy-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.section-content {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.7;
}

.agree-section {
  margin-top: 40rpx;
  text-align: center;
}

.agree-text {
  font-size: 24rpx;
  color: #94a3b8;
}