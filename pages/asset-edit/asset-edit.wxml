<view class="container">
  <!-- 状态栏 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;">
    <text class="status-time">9:41</text>
    <text class="status-dots">●●●</text>
  </view>

  <!-- 导航栏 -->
  <view class="nav-bar" style="height: {{navBarHeight}}px;">
    <view class="nav-btn" bindtap="goBack">‹</view>
    <view class="nav-title">{{mode === 'edit' ? '编辑资产' : '添加资产'}}</view>
    <view class="nav-btn {{mode === 'edit' ? '' : 'invisible'}}" bindtap="goBack">完成</view>
  </view>

  <!-- 资产类型切换 - 卡片式 -->
  <view class="type-tabs-card" wx:if="{{mode === 'add'}}">
    <view class="type-tab {{assetType === 'FUND' ? 'active' : ''}}" data-type="FUND" bindtap="switchType">
      <view class="type-tab-icon">基</view>
      <view class="type-tab-content">
        <view class="type-tab-name">基金</view>
        <view class="type-tab-desc">股票型、债券型、指数基金</view>
      </view>
      <view class="type-tab-check" wx:if="{{assetType === 'FUND'}}">✓</view>
    </view>
    <view class="type-tab {{assetType === 'STOCK' ? 'active' : ''}}" data-type="STOCK" bindtap="switchType">
      <view class="type-tab-icon">股</view>
      <view class="type-tab-content">
        <view class="type-tab-name">股票</view>
        <view class="type-tab-desc">A股、港股、美股</view>
      </view>
      <view class="type-tab-check" wx:if="{{assetType === 'STOCK'}}">✓</view>
    </view>
    <view class="type-tab {{assetType === 'DEPOSIT' ? 'active' : ''}}" data-type="DEPOSIT" bindtap="switchType">
      <view class="type-tab-icon">存</view>
      <view class="type-tab-content">
        <view class="type-tab-name">存款</view>
        <view class="type-tab-desc">定期、活期、大额存单</view>
      </view>
      <view class="type-tab-check" wx:if="{{assetType === 'DEPOSIT'}}">✓</view>
    </view>
  </view>

  <!-- 表单区域 -->
  <scroll-view scroll-y class="form-scroll">
    <!-- 基本信息卡片 -->
    <view class="form-card">
      <view class="form-card-header">
        <view class="form-card-icon">基</view>
        <view class="form-card-title">基本信息</view>
      </view>

      <!-- 名称 -->
      <view class="form-item">
        <view class="form-label">
          <text class="required">*</text>
          <text>{{assetType === 'DEPOSIT' ? '存款名称' : '资产名称'}}</text>
        </view>
        <input class="form-input {{errors.name ? 'error' : ''}}"
               type="text"
               placeholder="{{assetType === 'FUND' ? '如：易方达蓝筹精选' : assetType === 'STOCK' ? '如：宁德时代' : '如：招商银行定期'}}"
               data-field="name"
               value="{{form.name}}"
               bindinput="onInput"/>
        <text class="error-msg" wx:if="{{errors.name}}">{{errors.name}}</text>
      </view>

      <!-- 代码 -->
      <view class="form-item" wx:if="{{assetType !== 'DEPOSIT'}}">
        <view class="form-label">
          <text class="required">*</text>
          <text>{{assetType === 'FUND' ? '基金代码' : '股票代码'}}</text>
        </view>
        <input class="form-input {{errors.code ? 'error' : ''}}"
               type="text"
               placeholder="{{assetType === 'FUND' ? '如：005827' : '如：300750'}}"
               data-field="code"
               value="{{form.code}}"
               bindinput="onInput"/>
        <text class="error-msg" wx:if="{{errors.code}}">{{errors.code}}</text>
      </view>

      <!-- 平台 -->
      <view class="form-item">
        <view class="form-label">
          <text class="required">*</text>
          <text>{{assetType === 'DEPOSIT' ? '银行名称' : assetType === 'FUND' ? '购买平台' : '券商'}}</text>
        </view>
        <input class="form-input {{errors.platform ? 'error' : ''}}"
               type="text"
               placeholder="{{assetType === 'FUND' ? '如：支付宝、天天基金' : assetType === 'STOCK' ? '如：华泰、东方财富' : '如：招商银行'}}"
               data-field="platform"
               value="{{form.platform}}"
               bindinput="onInput"/>
        <text class="error-msg" wx:if="{{errors.platform}}">{{errors.platform}}</text>
      </view>
    </view>

    <!-- 分组选择 -->
    <view class="form-card">
      <view class="form-card-header">
        <view class="form-card-icon">组</view>
        <view class="form-card-title">选择分组</view>
      </view>
      <view class="group-tags">
        <view class="group-tag {{selectedGroupId === item.id ? 'active' : ''}}"
              wx:for="{{groups}}"
              wx:key="id"
              data-id="{{item.id}}"
              bindtap="selectGroup"
              style="{{selectedGroupId === item.id ? 'background: ' + item.color + '; border-color: ' + item.color : ''}}">
          <text class="group-dot" wx:if="{{selectedGroupId === item.id}}"></text>
          {{item.name}}
        </view>
      </view>
    </view>

    <!-- 投资信息卡片 -->
    <view class="form-card" wx:if="{{assetType !== 'DEPOSIT'}}">
      <view class="form-card-header">
        <view class="form-card-icon">投</view>
        <view class="form-card-title">投资信息</view>
      </view>

      <!-- 成本/净值 -->
      <view class="form-item">
        <view class="form-label">
          <text class="required">*</text>
          <text>{{assetType === 'FUND' ? '成本价' : '买入价'}}</text>
        </view>
        <input class="form-input {{errors.costPrice ? 'error' : ''}}"
               type="digit"
               placeholder="{{assetType === 'FUND' ? '如：1.523' : '如：280.50'}}"
               data-field="costPrice"
               value="{{form.costPrice}}"
               bindinput="onInput"/>
        <text class="error-msg" wx:if="{{errors.costPrice}}">{{errors.costPrice}}</text>
      </view>

      <!-- 持仓/数量 -->
      <view class="form-item">
        <view class="form-label">
          <text class="required">*</text>
          <text>{{assetType === 'FUND' ? '持仓份额' : '持仓数量'}}</text>
        </view>
        <input class="form-input {{errors.holdings ? 'error' : ''}}"
               type="digit"
               placeholder="{{assetType === 'FUND' ? '如：10000' : '如：100'}}"
               data-field="holdings"
               value="{{form.holdings}}"
               bindinput="onInput"/>
        <text class="error-msg" wx:if="{{errors.holdings}}">{{errors.holdings}}</text>
      </view>

      <!-- 当前净值 -->
      <view class="form-item" wx:if="{{assetType === 'FUND'}}">
        <view class="form-label">
          <text class="required">*</text>
          <text>最新净值</text>
        </view>
        <input class="form-input {{errors.nav ? 'error' : ''}}"
               type="digit"
               placeholder="如：1.650"
               data-field="nav"
               value="{{form.nav}}"
               bindinput="onInput"/>
        <text class="error-msg" wx:if="{{errors.nav}}">{{errors.nav}}</text>
      </view>
    </view>

    <!-- 存款信息卡片 -->
    <view class="form-card" wx:if="{{assetType === 'DEPOSIT'}}">
      <view class="form-card-header">
        <view class="form-card-icon">存</view>
        <view class="form-card-title">存款信息</view>
      </view>

      <!-- 金额 -->
      <view class="form-item">
        <view class="form-label">
          <text class="required">*</text>
          <text>存款金额</text>
        </view>
        <input class="form-input {{errors.amount ? 'error' : ''}}"
               type="digit"
               placeholder="如：100000"
               data-field="amount"
               value="{{form.amount}}"
               bindinput="onInput"/>
        <text class="error-msg" wx:if="{{errors.amount}}">{{errors.amount}}</text>
      </view>

      <!-- 年化利率 -->
      <view class="form-item">
        <view class="form-label">
          <text class="required">*</text>
          <text>年化利率</text>
        </view>
        <input class="form-input {{errors.annualRate ? 'error' : ''}}"
               type="digit"
               placeholder="如：3.85"
               data-field="annualRate"
               value="{{form.annualRate}}"
               bindinput="onInput"/>
        <text class="error-msg" wx:if="{{errors.annualRate}}">{{errors.annualRate}}</text>
      </view>

      <!-- 存款期限 -->
      <view class="form-item">
        <view class="form-label">
          <text class="required">*</text>
          <text>存款期限</text>
        </view>
        <input class="form-input {{errors.term ? 'error' : ''}}"
               type="text"
               placeholder="如：1年、3个月、活期"
               data-field="term"
               value="{{form.term}}"
               bindinput="onInput"/>
        <text class="error-msg" wx:if="{{errors.term}}">{{errors.term}}</text>
      </view>

      <!-- 到期日 -->
      <view class="form-item" wx:if="{{form.term !== '活期'}}">
        <view class="form-label">
          <text class="required">*</text>
          <text>到期日期</text>
        </view>
        <picker mode="date" value="{{form.endDate}}" bindchange="onDateChange">
          <view class="form-input {{errors.endDate ? 'error' : ''}}">
            {{form.endDate || '选择日期'}}
          </view>
        </picker>
        <text class="error-msg" wx:if="{{errors.endDate}}">{{errors.endDate}}</text>
      </view>
    </view>

    <!-- 备注 -->
    <view class="form-card">
      <view class="form-card-header">
        <view class="form-card-icon">备</view>
        <view class="form-card-title">备注</view>
      </view>
      <view class="form-item">
        <textarea class="form-textarea {{errors.note ? 'error' : ''}}"
                  placeholder="添加备注信息（可选）"
                  data-field="note"
                  value="{{form.note}}"
                  bindinput="onInput"
                  maxlength="200"/>
        <text class="error-msg" wx:if="{{errors.note}}">{{errors.note}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <view class="action-btn cancel-btn" bindtap="goBack">取消</view>
    <view class="action-btn save-btn" bindtap="saveAsset">{{mode === 'edit' ? '保存' : '添加'}}</view>
  </view>
</view>