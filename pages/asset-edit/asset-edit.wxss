.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
  padding-bottom: 40rpx;
}

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  box-sizing: border-box;
  background: #0f172a;
}

.status-time {
  font-size: 28rpx;
  font-weight: 600;
  color: #f8fafc;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20rpx;
  background: #0f172a;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #f8fafc;
  border-radius: 30rpx;
  transition: all 0.2s;
}

.nav-btn:active {
  background: rgba(255,255,255,0.1);
}

.nav-btn-placeholder {
  width: 60rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #f8fafc;
}

/* 资产类型切换 */
.asset-type-tabs {
  display: flex;
  padding: 30rpx 20rpx;
  gap: 20rpx;
  background: #0f172a;
}

.type-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  background: rgba(30, 41, 59, 0.8);
  border: 2rpx solid rgba(255,255,255,0.05);
  border-radius: 16rpx;
  transition: all 0.3s;
}

.type-tab.active {
  background: rgba(37, 99, 235, 0.2);
  border-color: #2563eb;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.type-name {
  font-size: 28rpx;
  color: #94a3b8;
  transition: color 0.3s;
}

.type-tab.active .type-name {
  color: #f8fafc;
  font-weight: 600;
}

/* 分组选择 */
.section-title {
  padding: 30rpx 30rpx 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #f8fafc;
}

.group-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 30rpx;
}

.group-tag {
  padding: 16rpx 32rpx;
  background: rgba(30, 41, 59, 0.8);
  border: 2rpx solid rgba(255,255,255,0.1);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #94a3b8;
  transition: all 0.2s;
}

.group-tag.active {
  background: #2563eb;
  border-color: #2563eb;
  color: #fff;
}

/* 表单区域 */
.form-section {
  margin: 20rpx 30rpx;
  padding: 20rpx;
  background: rgba(30, 41, 59, 0.6);
  border: 1rpx solid rgba(255,255,255,0.05);
  border-radius: 16rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item.half {
  flex: 1;
  margin-bottom: 0;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #94a3b8;
}

.required {
  color: #ef4444;
  margin-right: 4rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: rgba(15, 23, 42, 0.8);
  border: 2rpx solid rgba(255,255,255,0.1);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #f8fafc;
  box-sizing: border-box;
}

.form-input::placeholder {
  color: #64748b;
}

.form-input.error {
  border-color: #ef4444;
}

.form-input:focus {
  border-color: #2563eb;
}

.form-picker {
  display: flex;
  align-items: center;
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: rgba(15, 23, 42, 0.8);
  border: 2rpx solid rgba(255,255,255,0.1);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #f8fafc;
  box-sizing: border-box;
}

.form-picker.placeholder {
  color: #64748b;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: rgba(15, 23, 42, 0.8);
  border: 2rpx solid rgba(255,255,255,0.1);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #f8fafc;
  box-sizing: border-box;
}

.form-textarea::placeholder {
  color: #64748b;
}

.error-msg {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #ef4444;
}

.form-tip {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

/* 底部按钮 */
.form-footer {
  padding: 30rpx;
}

.btn {
  width: 100%;
  height: 90rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 45rpx;
  border: none;
}

.btn-primary {
  background: linear-gradient(90deg, #2563eb, #3b82f6);
  color: #fff;
}

.btn-primary:active {
  opacity: 0.9;
}

.btn-secondary {
  background: transparent;
  color: #94a3b8;
  border: 2rpx solid rgba(255,255,255,0.1);
}

.btn-secondary:active {
  background: rgba(255,255,255,0.05);
}

.safe-area-bottom {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}
