/* pages/profit-analysis/profit-analysis.wxss - 收益分析页 */

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  background: linear-gradient(90deg, rgba(37, 99, 235, 0.08) 0%, rgba(255, 255, 255, 0.8) 100%);
  font-size: 26rpx;
  font-weight: 500;
  color: #1e293b;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}

.status-time {
  font-weight: 600;
}

.status-dots {
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: rgba(255, 255, 255, 0.85);
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.5);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.nav-title {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
  background: linear-gradient(135deg, #2563eb, #10b981);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.nav-btn {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #64748b;
  background: rgba(241, 245, 249, 0.8);
  border-radius: 9999rpx;
}

/* 统计概览卡片 */
.stats-overview-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx 24rpx;
  margin: 24rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.stats-grid {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

.stats-item.positive .stats-value-large {
  color: #ef4444;
}

.stats-item.negative .stats-value-large {
  color: #10b981;
}

.stats-value-large {
  display: flex;
  align-items: baseline;
  font-family: 'DIN Alternate', 'SF Mono', 'Roboto Mono', monospace;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.stats-sign {
  font-size: 36rpx;
  font-weight: 600;
  margin-right: 2rpx;
}

.stats-number {
  font-size: 52rpx;
  letter-spacing: -0.02em;
}

.stats-unit {
  font-size: 32rpx;
  font-weight: 600;
  margin-left: 2rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 500;
}

.stats-divider {
  width: 2rpx;
  height: 80rpx;
  background: linear-gradient(180deg, transparent, #e2e8f0, transparent);
}

/* 时间范围切换 */
.time-range-section {
  margin: 0 32rpx 24rpx;
}

.time-range-tabs {
  display: flex;
  gap: 12rpx;
}

.range-tab {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #64748b;
}

.range-tab.active {
  background: #2563eb;
  color: #ffffff;
  border-color: #2563eb;
}

/* 图表卡片 */
.chart-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.chart-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.chart-subtitle {
  font-size: 24rpx;
  color: #94a3b8;
}

.chart-container {
  height: 300rpx;
  margin-bottom: 20rpx;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(226, 232, 240, 0.6);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.legend-text {
  font-size: 24rpx;
  color: #64748b;
}

/* 区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  padding: 0 32rpx;
  margin: 32rpx 0 20rpx;
}

/* 收益明细卡片 */
.profit-detail-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.detail-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 36rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.detail-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.detail-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.detail-date {
  font-size: 22rpx;
  color: #94a3b8;
}

.detail-value {
  font-size: 32rpx;
  font-weight: 700;
  font-family: 'SF Mono', 'Roboto Mono', monospace;
}

.detail-value.positive {
  color: #ef4444;
}

.detail-value.negative {
  color: #10b981;
}

/* 分析卡片 */
.analysis-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.analysis-item {
  margin-bottom: 32rpx;
}

.analysis-item:last-child {
  margin-bottom: 0;
}

.analysis-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.analysis-name {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 600;
}

.analysis-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #2563eb;
}

.analysis-desc {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 16rpx;
}

.analysis-bar {
  height: 16rpx;
  background: #f1f5f9;
  border-radius: 8rpx;
  overflow: hidden;
}

.analysis-progress {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

/* 排行卡片 */
.rank-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-number {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.rank-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.rank-type {
  font-size: 22rpx;
  color: #94a3b8;
}

.rank-profit {
  text-align: right;
}

.rank-profit-value {
  font-size: 28rpx;
  font-weight: 700;
  font-family: 'SF Mono', 'Roboto Mono', monospace;
}

.rank-profit.positive {
  color: #ef4444;
}

.rank-profit.negative {
  color: #10b981;
}

/* 主要按钮 */
.btn-primary {
  margin: 48rpx 32rpx;
  padding: 28rpx 48rpx;
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  color: white;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border-radius: 9999rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.25);
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}
