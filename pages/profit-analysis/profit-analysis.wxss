/* pages/profit-analysis/profit-analysis.wxss - 收益分析页 */

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  background: linear-gradient(90deg, rgba(37, 99, 235, 0.08) 0%, rgba(255, 255, 255, 0.8) 100%);
  font-size: 26rpx;
  font-weight: 500;
  color: #1e293b;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}

.status-time { font-weight: 600; }
.status-dots { font-size: 20rpx; letter-spacing: 2rpx; }

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: rgba(255, 255, 255, 0.85);
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.5);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.nav-title {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
  background: linear-gradient(135deg, #2563eb, #10b981);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.nav-btn {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #64748b;
  background: rgba(241, 245, 249, 0.8);
  border-radius: 9999rpx;
}

/* 统计概览卡片 */
.stats-overview-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  margin: 24rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.stats-grid {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 4rpx;
}

.stats-value-container {
  display: flex;
  align-items: baseline;
  justify-content: center;
  font-family: 'DIN Alternate', 'SF Mono', 'Roboto Mono', monospace;
  font-weight: 700;
  gap: 4rpx;
}

.stats-item.positive .stats-value-container { color: #ef4444; }
.stats-item.negative .stats-value-container { color: #10b981; }

.stats-sign { font-size: 24rpx; font-weight: 600; }
.stats-number { font-size: 32rpx; letter-spacing: -0.02em; }
.stats-unit { font-size: 20rpx; font-weight: 600; }
.stats-label { font-size: 20rpx; color: #94a3b8; font-weight: 500; white-space: nowrap; margin-top: 6rpx; }

.stats-divider {
  width: 1rpx;
  height: 80rpx;
  background: linear-gradient(180deg, transparent, #e2e8f0, transparent);
  align-self: center;
}

/* 视图控制区域 */
.view-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  margin-bottom: 16rpx;
}

.view-mode-tabs {
  display: flex;
  gap: 6rpx;
  background: #f1f5f9;
  border-radius: 20rpx;
  padding: 4rpx;
}

.view-tab {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #64748b;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.view-tab.active { background: #2563eb; color: #ffffff; }

.time-range-tabs {
  display: flex;
  gap: 12rpx;
}

.range-tab {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #64748b;
}

.range-tab.active { background: #2563eb; color: #ffffff; border-color: #2563eb; }

/* 图表卡片 */
.chart-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 0 32rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.chart-title { font-size: 28rpx; font-weight: 700; color: #1e293b; }
.chart-subtitle { font-size: 24rpx; color: #94a3b8; }
.chart-container { height: 300rpx; margin-bottom: 20rpx; }

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(226, 232, 240, 0.6);
}

.legend-item { display: flex; align-items: center; gap: 8rpx; }
.legend-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.legend-text { font-size: 24rpx; color: #64748b; }

/* 区块标题 */
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
  padding: 0 32rpx;
  margin: 24rpx 0 16rpx;
}

/* 收益明细卡片 */
.profit-detail-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 0 32rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.detail-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}

.detail-item:last-child { border-bottom: none; }

.detail-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.detail-info { flex: 1; display: flex; flex-direction: column; gap: 2rpx; }
.detail-name { font-size: 26rpx; font-weight: 600; color: #1e293b; }
.detail-date { font-size: 20rpx; color: #94a3b8; }

.detail-value { font-size: 28rpx; font-weight: 700; font-family: 'SF Mono', 'Roboto Mono', monospace; }
.detail-value.positive { color: #ef4444; }
.detail-value.negative { color: #10b981; }

.detail-value-group { display: flex; flex-direction: column; align-items: flex-end; gap: 2rpx; }
.detail-percent { font-size: 20rpx; font-weight: 600; font-family: 'SF Mono', 'Roboto Mono', monospace; }
.detail-percent.positive { color: #ef4444; }
.detail-percent.negative { color: #10b981; }

/* ============ 收益日历 ============ */
.calendar-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 16rpx;
  margin: 0 32rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.calendar-nav {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f5f9;
  border-radius: 50%;
  font-size: 24rpx;
  color: #64748b;
  font-weight: 600;
}

.calendar-nav.disabled { opacity: 0.3; }
.calendar-title { font-size: 28rpx; font-weight: 700; color: #1e293b; text-decoration: underline; text-decoration-color: #94a3b8; text-underline-offset: 4rpx; }

/* 周期切换 */
.period-tabs {
  display: flex;
  gap: 4rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 4rpx;
  margin-bottom: 12rpx;
}

.period-tab {
  flex: 1;
  padding: 8rpx 0;
  font-size: 22rpx;
  font-weight: 500;
  color: #64748b;
  text-align: center;
  border-radius: 8rpx;
  transition: all 0.3s ease;
}

.period-tab.active {
  background: #ffffff;
  color: #2563eb;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

/* 底部控制栏 */
.calendar-footer {
  display: flex;
  align-items: center;
  padding-top: 12rpx;
}

.display-toggle {
  display: flex;
  align-items: center;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 4rpx 10rpx;
}

.toggle-btn {
  font-size: 22rpx;
  font-weight: 600;
  color: #94a3b8;
  padding: 4rpx 8rpx;
}

.toggle-btn.active {
  color: #2563eb;
}

.toggle-divider {
  font-size: 24rpx;
  color: #94a3b8;
}

.calendar-summary {
  display: flex;
  align-items: center;
}

.summary-text {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

.summary-text .up { color: #ef4444; font-weight: 700; font-family: 'SF Mono', 'Roboto Mono', monospace; }
.summary-text .down { color: #10b981; font-weight: 700; font-family: 'SF Mono', 'Roboto Mono', monospace; }
.month-calendar-grid {
  margin-bottom: 12rpx;
}

.calendar-weekday-row {
  display: flex;
  margin-bottom: 4rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: 500;
}

.calendar-days-container {
  display: flex;
  flex-direction: column;
}

.calendar-day-row {
  display: flex;
  flex-direction: row;
}

.calendar-day-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rpx 0;
  min-height: 64rpx;
}

.calendar-day-cell.empty {
  visibility: hidden;
}

.day-num {
  font-size: 24rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 2rpx;
}

.calendar-day-cell.today .day-num {
  background: #2563eb;
  color: #ffffff;
  border-radius: 50%;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 2rpx;
}

.day-profit {
  font-size: 16rpx;
  font-weight: 600;
  font-family: 'SF Mono', 'Roboto Mono', monospace;
}

.day-profit.up { color: #ef4444; }
.day-profit.down { color: #10b981; }

/* 年视图网格 */
.year-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.year-month-cell {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 4rpx;
  box-sizing: border-box;
}

.year-month-cell.current {
  background: rgba(37, 99, 235, 0.05);
  border-radius: 8rpx;
}

.year-month-label {
  font-size: 18rpx;
  color: #64748b;
  margin-bottom: 4rpx;
  font-weight: 500;
}

.year-month-value {
  font-size: 18rpx;
  font-weight: 700;
  font-family: 'SF Mono', 'Roboto Mono', monospace;
}

.year-month-value.up { color: #ef4444; }
.year-month-value.down { color: #10b981; }

/* ============ 多年视图 ============ */
.years-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.years-year-cell {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 4rpx;
  box-sizing: border-box;
}

.years-year-cell.current {
  background: rgba(37, 99, 235, 0.05);
  border-radius: 8rpx;
}

.years-year-label {
  font-size: 20rpx;
  color: #64748b;
  margin-bottom: 4rpx;
  font-weight: 500;
}

.years-year-value {
  font-size: 22rpx;
  font-weight: 700;
  font-family: 'SF Mono', 'Roboto Mono', monospace;
}

.years-year-value.up { color: #ef4444; }
.years-year-value.down { color: #10b981; }

.summary-value { font-size: 28rpx; font-weight: 700; font-family: 'SF Mono', 'Roboto Mono', monospace; }
.summary-percent { font-size: 22rpx; font-weight: 600; font-family: 'SF Mono', 'Roboto Mono', monospace; }
.summary-value.up, .summary-percent.up { color: #ef4444; }
.summary-value.down, .summary-percent.down { color: #10b981; }

/* 公共颜色 */
.up { color: #ef4444; }
.down { color: #10b981; }

/* 分析卡片 */
.analysis-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 0 32rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.analysis-item { margin-bottom: 20rpx; }
.analysis-item:last-child { margin-bottom: 0; }

.analysis-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.analysis-name { font-size: 28rpx; color: #1e293b; font-weight: 600; }
.analysis-value { font-size: 28rpx; font-weight: 700; color: #2563eb; }
.analysis-desc { font-size: 24rpx; color: #64748b; margin-bottom: 16rpx; }

.analysis-bar {
  height: 16rpx;
  background: #f1f5f9;
  border-radius: 8rpx;
  overflow: hidden;
}

.analysis-progress {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

/* 排行卡片 */
.rank-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 0 32rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}

.rank-item:last-child { border-bottom: none; }

.rank-number {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.rank-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.rank-name { font-size: 28rpx; font-weight: 600; color: #1e293b; }
.rank-type { font-size: 22rpx; color: #94a3b8; }

.rank-profit { text-align: right; }
.rank-profit-value { font-size: 28rpx; font-weight: 700; font-family: 'SF Mono', 'Roboto Mono', monospace; }
.rank-profit.positive { color: #ef4444; }
.rank-profit.negative { color: #10b981; }

/* 按钮 */
.btn-primary {
  margin: 32rpx 32rpx;
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  border-radius: 9999rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.25);
}

.btn-primary:active { transform: scale(0.98); opacity: 0.9; }

/* 日期详情弹窗 */
.day-detail-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.day-detail-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx;
  margin: 0 64rpx;
  width: 560rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.day-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.day-detail-date { font-size: 32rpx; font-weight: 700; color: #1e293b; }

.day-detail-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f5f9;
  border-radius: 50%;
  font-size: 36rpx;
  color: #64748b;
}

.day-detail-content { display: flex; flex-direction: column; gap: 24rpx; }

.day-detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}

.day-detail-item:last-child { border-bottom: none; }
.day-detail-label { font-size: 28rpx; color: #64748b; }
.day-detail-value { font-size: 32rpx; font-weight: 700; font-family: 'SF Mono', 'Roboto Mono', monospace; }
.day-detail-value.up { color: #ef4444; }
.day-detail-value.down { color: #10b981; }
