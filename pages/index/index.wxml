<view class="container">
  <!-- 状态栏 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;">
    <text class="status-time">9:41</text>
    <text class="status-dots">●●●</text>
  </view>

  <!-- 导航栏 -->
  <view class="nav-bar" style="height: {{navBarHeight}}px;">
    <view class="nav-btn" style="visibility: hidden;">‹</view>
    <view class="nav-title">全资产管理工具</view>
    <view class="nav-btn refresh-btn {{isRefreshing ? 'refreshing' : ''}}" bindtap="onRefreshTap">
      <text class="refresh-icon">↻</text>
    </view>
  </view>

  <!-- 总资产卡片 - 紧凑版 -->
  <view class="total-asset-card">
    <view class="total-asset-header">
      <text class="total-asset-label">总资产（元）</text>
      <view class="eye-icon" bindtap="toggleAmountVisibility">{{showAmount ? '●' : '○'}}</view>
    </view>
    <view class="total-asset-main">
      <view class="total-asset-amount">{{showAmount ? '¥ 386,542.00' : '¥ ****'}}</view>
      <view class="total-asset-change">
        <view class="change-amount rise">+ ¥ 2,348.00</view>
        <view class="change-percent rise">今日 +0.61%</view>
      </view>
    </view>
  </view>

  <!-- 市场行情 - 横向滚动卡片 -->
  <view class="market-card">
    <view class="card-header-row">
      <text class="card-title-text">市场行情</text>
      <text class="card-update-time">更新时间: 今日</text>
    </view>
    <scroll-view class="market-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="market-items">
        <view class="market-item {{item.changePercent >= 0 ? 'rise' : 'fall'}}" wx:for="{{marketIndices}}" wx:key="code">
          <view class="market-item-name">{{item.name}}</view>
          <view class="market-item-code">{{item.code}}</view>
          <view class="market-item-price">{{item.price}}</view>
          <view class="market-item-change">{{item.changePercent > 0 ? '+' : ''}}{{item.changePercent}}%</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 当日收益走势 -->
  <view class="today-trend-section">
    <view class="section-header-row">
      <text class="section-title">今日走势</text>
      <text class="trend-update-time">实时更新</text>
    </view>
    <view class="today-trend-card">
      <view class="trend-chart-container">
        <view class="trend-line-chart">
          <canvas type="2d" id="todayTrendCanvas" style="width: 100%; height: 100%;"></canvas>
        </view>
      </view>
      <view class="today-summary">
        <view class="today-item">
          <text class="today-label">今日收益</text>
          <text class="today-value {{todayProfit >= 0 ? 'rise' : 'fall'}}">{{todayProfit >= 0 ? '+' : ''}}{{todayProfitText}}</text>
        </view>
        <view class="today-item">
          <text class="today-label">今日收益率</text>
          <text class="today-rate {{todayProfitPercent >= 0 ? 'rise' : 'fall'}}">{{todayProfitPercent >= 0 ? '+' : ''}}{{todayProfitPercent}}%</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 资产分类列表 -->
  <view class="section-header">
    <text class="section-title">资产分类</text>
  </view>

  <view class="category-list">
    <view class="category-item" wx:for="{{allocationData}}" wx:key="type" bindtap="gotoAssets">
      <view class="category-icon-wrap {{item.type}}">
        <text class="category-icon-text">{{item.icon}}</text>
      </view>
      <view class="category-info">
        <text class="category-name">{{item.name}}</text>
        <text class="category-count">{{item.count}}只持仓</text>
      </view>
      <view class="category-value">
        <text class="category-amount">{{showAmount ? item.value : '****'}}</text>
        <text class="category-change {{item.change >= 0 ? 'rise' : 'fall'}}">{{item.change >= 0 ? '+' : ''}}{{item.change}}%</text>
      </view>
    </view>
  </view>

  <!-- 市场快讯 -->
  <view class="news-card">
    <news-flash newsList="{{newsFlash}}" bind:viewMore="gotoIntelligence"></news-flash>
  </view>
</view>

<!-- 底部导航栏 -->
<tab-bar activeIndex="{{0}}"></tab-bar>