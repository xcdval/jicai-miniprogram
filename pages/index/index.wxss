/* pages/index/index.wxss - 基于 jicai-fixed.html 优化 */

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  background: linear-gradient(90deg, rgba(37, 99, 235, 0.08) 0%, rgba(255, 255, 255, 0.8) 100%);
  font-size: 26rpx;
  font-weight: 500;
  color: #1e293b;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}

.status-time {
  font-weight: 600;
}

.status-dots {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  transition: all 0.3s ease;
}

.status-dots.refreshing {
  color: #10b981;
  animation: pulse 1s ease-in-out infinite;
}

/* 导航栏 - 毛玻璃效果 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: rgba(255, 255, 255, 0.85);
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.5);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.nav-title {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
  background: var(--color-gradient);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  border-radius: 9999rpx;
  font-size: 32rpx;
  color: var(--color-primary);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.refresh-btn {
  transition: transform 0.3s ease;
}

.refresh-btn .refresh-icon {
  display: block;
  transition: transform 0.3s ease;
}

.refresh-btn.refreshing .refresh-icon {
  animation: rotate 1s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 总资产卡片 - 紧凑版 */
.total-asset-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin: 24rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.total-asset-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.total-asset-label {
  font-size: 26rpx;
  color: #64748b;
  font-weight: 500;
}

.eye-icon {
  font-size: 28rpx;
  padding: 8rpx;
}

.total-asset-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.total-asset-amount {
  font-size: 44rpx;
  font-weight: 800;
  font-family: 'SF Mono', 'Roboto Mono', 'Courier New', monospace;
  letter-spacing: -0.02em;
  color: #1e293b;
}

.total-asset-change {
  text-align: right;
}

.change-amount {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.change-percent {
  font-size: 22rpx;
  font-weight: 500;
  margin-top: 2rpx;
}

.change-amount.rise,
.change-percent.rise {
  color: #ef4444;
}

.change-amount.fall,
.change-percent.fall {
  color: var(--color-accent);
}

/* 市场行情卡片 */
.market-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 0 28rpx 32rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.card-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-right: 32rpx;
}

.card-title-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.card-update-time {
  font-size: 22rpx;
  color: #94a3b8;
}

.market-scroll {
  white-space: nowrap;
}

.market-items {
  display: flex;
  gap: 20rpx;
  padding-right: 32rpx;
}

.market-item {
  min-width: 200rpx;
  flex-shrink: 0;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 16rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  text-align: center;
}

.market-item-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 4rpx;
}

.market-item-code {
  font-size: 20rpx;
  color: #94a3b8;
  margin-bottom: 12rpx;
}

.market-item-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.market-item-change {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
  display: inline-block;
}

.market-item.rise .market-item-change {
  color: #ef4444;
  background: rgba(239, 68, 68, 0.1);
}

.market-item.fall .market-item-change {
  color: var(--color-accent);
  background: rgba(16, 185, 129, 0.1);
}

/* 两列网格布局 */
.grid-2-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin: 0 32rpx 24rpx;
}

.mini-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.mini-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 20rpx;
}

/* 饼图 */
.pie-chart {
  display: flex;
  justify-content: center;
  margin-bottom: 16rpx;
}

.pie-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.pie-inner {
  position: absolute;
  inset: 28rpx;
  background: white;
  border-radius: 50%;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.pie-legend {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.6;
}

/* 收益走势 */
.trend-chart {
  height: 140rpx;
  background: linear-gradient(180deg, rgba(37, 99, 235, 0.05) 0%, rgba(255, 255, 255, 0.1) 100%);
  border-radius: 16rpx;
  border: 1rpx solid rgba(37, 99, 235, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  position: relative;
  overflow: hidden;
}

.trend-text {
  font-size: 24rpx;
  color: #64748b;
}

.trend-summary {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 区块标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  margin: 32rpx 0 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  letter-spacing: -0.02em;
}

.section-more {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
}

/* 资产分类列表 - 原HTML风格 */
.category-list {
  padding: 0 32rpx;
}

.category-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.category-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  margin-right: 24rpx;
}

.category-icon-wrap.fund {
  background: rgba(16, 185, 129, 0.1);
}

.category-icon-wrap.stock {
  background: rgba(239, 68, 68, 0.1);
}

.category-icon-wrap.deposit {
  background: rgba(139, 92, 246, 0.1);
}

.category-icon-text {
  font-size: 36rpx;
}

.category-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.category-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.category-count {
  font-size: 22rpx;
  color: #94a3b8;
}

.category-value {
  text-align: right;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.category-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.category-change {
  font-size: 22rpx;
  font-weight: 500;
}

.category-change.rise {
  color: #ef4444;
}

/* 市场快讯区域 */
.news-section {
  padding: 0 32rpx;
}

.news-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.category-change.fall {
  color: var(--color-accent);
}

/* 通用涨跌样式 */
.rise {
  color: #ef4444;
}

.fall {
  color: var(--color-accent);
}

/* 今日走势区域 */
.today-trend-section {
  margin: 0 32rpx 24rpx;
}

.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.trend-update-time {
  font-size: 22rpx;
  color: #94a3b8;
}

.today-trend-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.trend-chart-container {
  height: 200rpx;
  margin-bottom: 24rpx;
}

.trend-line-chart {
  width: 100%;
  height: 100%;
}

.today-summary {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(226, 232, 240, 0.6);
}

.today-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.today-label {
  font-size: 24rpx;
  color: #64748b;
}

.today-value {
  font-size: 36rpx;
  font-weight: 700;
  font-family: 'SF Mono', 'Roboto Mono', monospace;
}

.today-rate {
  font-size: 32rpx;
  font-weight: 700;
  font-family: 'SF Mono', 'Roboto Mono', monospace;
}

.today-value.rise,
.today-rate.rise {
  color: #ef4444;
}

.today-value.fall,
.today-rate.fall {
  color: var(--color-accent);
}
