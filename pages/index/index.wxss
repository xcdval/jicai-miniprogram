/* pages/index/index.wxss */

/* 导航栏 - 简约设计 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  margin-bottom: 8rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  letter-spacing: -0.02em;
}

.nav-actions {
  display: flex;
  gap: 16rpx;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 16rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

/* 资产总览卡片 - 科技感渐变 */
.asset-overview-card {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin: 16rpx 32rpx 32rpx;
  box-shadow: 0 10rpx 40rpx rgba(37, 99, 235, 0.25);
  color: white;
  position: relative;
  overflow: hidden;
}

.asset-overview-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}

.overview-label {
  font-size: 26rpx;
  opacity: 0.85;
  font-weight: 500;
}

.eye-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 14rpx;
  font-size: 28rpx;
  backdrop-filter: blur(10rpx);
}

.overview-amount {
  font-size: 60rpx;
  font-weight: 800;
  margin-bottom: 28rpx;
  letter-spacing: -0.03em;
  position: relative;
  z-index: 1;
}

/* 统计项 - 卡片式布局 */
.overview-stats {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.75;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 700;
}

.stat-value.rise {
  color: #86efac;
}

.stat-value.fall {
  color: #fecaca;
}

/* 市场行情滚动 */
.market-ticker {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.ticker-wrapper {
  display: flex;
  gap: 28rpx;
}

.ticker-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  white-space: nowrap;
}

.ticker-name {
  font-size: 20rpx;
  opacity: 0.8;
  font-weight: 500;
}

.ticker-change {
  font-size: 22rpx;
  font-weight: 700;
}

.ticker-item.rise .ticker-change {
  color: #86efac;
}

.ticker-item.fall .ticker-change {
  color: #fecaca;
}

/* 区块标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  margin: 32rpx 0 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  letter-spacing: -0.02em;
}

.section-more {
  font-size: 24rpx;
  color: #2563eb;
  font-weight: 500;
}

/* 资产配置列表 - 新设计 */
.allocation-list {
  padding: 0 32rpx;
}

.allocation-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(226, 232, 240, 0.6);
  transition: all 0.3s ease;
}

.allocation-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.allocation-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.allocation-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
}

.allocation-card.fund .allocation-icon-wrap {
  background: linear-gradient(135deg, #10b981, #059669);
}

.allocation-card.stock .allocation-icon-wrap {
  background: linear-gradient(135deg, #f59e0b, #d97706);
}

.allocation-card.deposit .allocation-icon-wrap {
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
}

.allocation-icon {
  font-size: 36rpx;
}

.allocation-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.allocation-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.allocation-count {
  font-size: 22rpx;
  color: #94a3b8;
}

.allocation-data {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.allocation-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.allocation-change {
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.allocation-change.rise {
  color: #ef4444;
  background: rgba(239, 68, 68, 0.1);
}

.allocation-change.fall {
  color: #10b981;
  background: rgba(16, 185, 129, 0.1);
}
