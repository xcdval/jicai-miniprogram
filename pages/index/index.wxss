/* pages/index/index.wxss */

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  margin-bottom: 16rpx;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e293b;
}

.nav-actions {
  display: flex;
  gap: 24rpx;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  font-size: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 资产总览卡片 */
.asset-overview-card {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(37, 99, 235, 0.25);
  color: white;
}

.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.overview-label {
  font-size: 28rpx;
  opacity: 0.9;
}

.eye-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  font-size: 28rpx;
}

.overview-amount {
  font-size: 64rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
  letter-spacing: -1rpx;
}

.overview-stats {
  display: flex;
  gap: 48rpx;
  margin-bottom: 32rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.8;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 600;
}

.stat-value.rise {
  color: #86efac;
}

.stat-value.fall {
  color: #fecaca;
}

/* 市场行情滚动 */
.market-ticker {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  overflow: hidden;
}

.ticker-wrapper {
  display: flex;
  gap: 32rpx;
}

.ticker-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  white-space: nowrap;
}

.ticker-name {
  font-size: 22rpx;
  opacity: 0.9;
}

.ticker-change {
  font-size: 24rpx;
  font-weight: 600;
}

.ticker-item.rise .ticker-change {
  color: #86efac;
}

.ticker-item.fall .ticker-change {
  color: #fecaca;
}

/* 资产配置 */
.allocation-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.allocation-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.allocation-item:active {
  transform: scale(0.98);
  background: #f1f5f9;
}

.allocation-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  border-radius: 20rpx;
  font-size: 36rpx;
}

.allocation-item.fund .allocation-icon {
  background: linear-gradient(135deg, #10b981, #059669);
}

.allocation-item.stock .allocation-icon {
  background: linear-gradient(135deg, #f59e0b, #d97706);
}

.allocation-item.deposit .allocation-icon {
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
}

.allocation-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.allocation-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1e293b;
}

.allocation-value {
  font-size: 22rpx;
  color: #64748b;
}

.allocation-percent {
  font-size: 28rpx;
  font-weight: 600;
  color: #2563eb;
}

/* 查看更多 */
.card-more {
  font-size: 24rpx;
  color: #2563eb;
  font-weight: 500;
}

/* 快捷功能 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 16rpx;
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.quick-item:active {
  background: #f1f5f9;
}

.quick-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  font-size: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.quick-icon.fund {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
}

.quick-icon.intel {
  background: linear-gradient(135deg, #f59e0b, #d97706);
}

.quick-icon.analysis {
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
}

.quick-icon.add {
  background: linear-gradient(135deg, #10b981, #059669);
}

.quick-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #475569;
}