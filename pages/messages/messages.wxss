/* pages/messages/messages.wxss */

.container {
  min-height: 100vh;
  background: #f5f6f8;
}

/* Tab Header */
.tab-header {
  display: flex;
  background: #ffffff;
  padding: 0 32rpx;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.8);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #64748b;
  position: relative;
  gap: 8rpx;
}

.tab-item.active {
  color: #8B5CF6;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #8B5CF6;
  border-radius: 3rpx;
}

.tab-badge {
  background: #ef4444;
  color: #ffffff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
}

/* Content */
.content {
  padding: 24rpx 32rpx;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #94a3b8;
  text-align: center;
  padding: 0 64rpx;
}

/* Notification List */
.notification-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.notification-item {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.6);
  position: relative;
}

.notification-item.read {
  opacity: 0.7;
}

.notification-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.notification-icon-wrap.priceAlert {
  background: rgba(239, 68, 68, 0.1);
}

.notification-icon-wrap.changeAlert {
  background: rgba(245, 158, 11, 0.1);
}

.notification-icon-wrap.depositExpiry {
  background: rgba(139, 92, 246, 0.1);
}

.notification-icon-wrap.systemNotice {
  background: rgba(59, 130, 246, 0.1);
}

.notification-icon {
  font-size: 36rpx;
}

.notification-content {
  flex: 1;
}

.notification-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.notification-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  flex: 1;
}

.notification-time {
  font-size: 22rpx;
  color: #94a3b8;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.notification-body {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.notification-footer {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.notification-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.notification-tag.high {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
}

.notification-tag.medium {
  background: rgba(245, 158, 11, 0.1);
  color: #f59e0b;
}

.notification-tag.low {
  background: rgba(100, 116, 139, 0.1);
  color: #64748b;
}

.notification-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-left: 16rpx;
}

.notification-actions .action-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 32rpx;
  color: #94a3b8;
}

.notification-actions .action-btn.delete:hover {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
}

/* Reminder List */
.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.reminder-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.6);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.reminder-item.disabled {
  opacity: 0.5;
}

.reminder-info {
  flex: 1;
}

.reminder-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.reminder-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.reminder-type-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  background: rgba(139, 92, 246, 0.1);
  color: #8B5CF6;
  border-radius: 8rpx;
}

.reminder-condition {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.reminder-created {
  font-size: 22rpx;
  color: #94a3b8;
}

.reminder-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.reminder-actions .action-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 32rpx;
  color: #94a3b8;
}

.reminder-actions .action-btn.delete:hover {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
}

/* Info Card */
.info-card {
  background: rgba(139, 92, 246, 0.08);
  border: 1rpx solid rgba(139, 92, 246, 0.2);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}

.info-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8B5CF6;
  margin-bottom: 8rpx;
  display: block;
}

.info-text {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

/* Bottom Actions */
.bottom-actions {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  padding: 32rpx 0;
  margin-top: 24rpx;
}

.action-link {
  font-size: 26rpx;
  color: #8B5CF6;
  padding: 12rpx 24rpx;
}

.action-link.danger {
  color: #ef4444;
}

/* Switch 样式 */
switch .wx-switch-input {
  background: #8B5CF6 !important;
}

switch .wx-switch-input::after {
  background: #ffffff !important;
}