/* pages/analysis/analysis.wxss */
.nav-bar { display: flex; justify-content: center; align-items: center; padding: 0 32rpx; margin-bottom: 16rpx; }
.nav-title { font-size: 40rpx; font-weight: 700; color: #1e293b; }

.health-card { background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); border-radius: 32rpx; padding: 40rpx 32rpx; margin: 0 32rpx 24rpx; box-shadow: 0 8rpx 32rpx rgba(37,99,235,0.25); color: white; }
.health-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.health-label { font-size: 28rpx; opacity: 0.9; }
.health-score { font-size: 72rpx; font-weight: 700; }
.health-bar { height: 12rpx; background: rgba(255,255,255,0.2); border-radius: 6rpx; overflow: hidden; margin-bottom: 16rpx; }
.health-progress { height: 100%; border-radius: 6rpx; transition: width 0.5s ease; }
.health-desc { font-size: 24rpx; opacity: 0.9; }

.industry-list { display: flex; flex-direction: column; gap: 20rpx; }
.industry-item { display: flex; align-items: center; gap: 16rpx; }
.industry-color { width: 24rpx; height: 24rpx; border-radius: 6rpx; }
.industry-name { flex: 1; font-size: 28rpx; color: #1e293b; }
.industry-percent { font-size: 28rpx; font-weight: 600; color: #2563eb; }

.suggestion-item { display: flex; gap: 20rpx; padding: 24rpx; background: #f8fafc; border-radius: 20rpx; margin-bottom: 16rpx; border-left: 6rpx solid #cbd5e1; }
.suggestion-item.warning { border-left-color: #f59e0b; background: rgba(245,158,11,0.08); }
.suggestion-item.success { border-left-color: #10b981; background: rgba(16,185,129,0.08); }
.suggestion-item.info { border-left-color: #2563eb; background: rgba(37,99,235,0.08); }
.suggestion-icon { font-size: 40rpx; }
.suggestion-content { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.suggestion-title { font-size: 28rpx; font-weight: 600; color: #1e293b; }
.suggestion-desc { font-size: 24rpx; color: #64748b; line-height: 1.5; }