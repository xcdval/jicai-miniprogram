/* pages/analysis/analysis.wxss - 基于 jicai-fixed.html */

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  background: linear-gradient(90deg, rgba(37, 99, 235, 0.08) 0%, rgba(255, 255, 255, 0.8) 100%);
  font-size: 26rpx;
  font-weight: 500;
  color: #1e293b;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}

.status-time {
  font-weight: 600;
}

.status-dots {
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: rgba(255, 255, 255, 0.85);
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.5);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.nav-title {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
  background: linear-gradient(135deg, #2563eb, #10b981);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.nav-btn {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #64748b;
  background: rgba(241, 245, 249, 0.8);
  border-radius: 9999rpx;
}

/* 持仓健康度评分卡片 */
.health-score-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  margin: 24rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  text-align: center;
}

.health-circle {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 50%, white 55%, rgba(16, 185, 129, 0.3) 56%, rgba(16, 185, 129, 0.1) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.15);
}

.health-score {
  font-size: 72rpx;
  font-weight: 800;
  color: #10b981;
  font-family: 'SF Mono', 'Roboto Mono', monospace;
}

.health-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.health-desc {
  font-size: 24rpx;
  color: #94a3b8;
}

/* 区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  padding: 0 32rpx;
  margin: 32rpx 0 20rpx;
}

/* 分析卡片 */
.analysis-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.analysis-item {
  margin-bottom: 32rpx;
}

.analysis-item:last-child {
  margin-bottom: 0;
}

.analysis-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.analysis-name {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 600;
}

.analysis-level {
  font-size: 28rpx;
  font-weight: 700;
}

.analysis-level.warning {
  color: #f59e0b;
}

.analysis-level.success {
  color: #10b981;
}

.analysis-bar {
  height: 16rpx;
  background: #f1f5f9;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.analysis-progress {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.analysis-tip {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

/* 优化建议卡片 */
.suggestion-card {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(37, 99, 235, 0.04) 100%);
  border: 2rpx solid rgba(16, 185, 129, 0.2);
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
}

.suggestion-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.suggestion-content {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
}

/* 行业分布卡片 */
.industry-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.industry-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.industry-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f8fafc;
}

.industry-item:last-child {
  border-bottom: none;
}

.industry-color {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.industry-name {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
}

.industry-percent {
  font-size: 28rpx;
  font-weight: 700;
  color: #2563eb;
  font-family: 'SF Mono', monospace;
}

/* 主要按钮 */
.btn-primary {
  margin: 48rpx 32rpx;
  padding: 28rpx 48rpx;
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  color: white;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border-radius: 9999rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.25);
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 统计概览卡片 */
.stats-overview-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  margin: 24rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.stats-grid {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 4rpx;
}

.stats-value-container {
  display: flex;
  align-items: baseline;
  justify-content: center;
  font-family: 'DIN Alternate', 'SF Mono', 'Roboto Mono', monospace;
  font-weight: 700;
  gap: 4rpx;
}

.stats-item.positive .stats-value-container { color: #ef4444; }
.stats-item.negative .stats-value-container { color: #10b981; }

.stats-sign { font-size: 24rpx; font-weight: 600; }
.stats-number { font-size: 32rpx; letter-spacing: -0.02em; }
.stats-unit { font-size: 20rpx; font-weight: 600; }
.stats-label { font-size: 20rpx; color: #94a3b8; font-weight: 500; white-space: nowrap; margin-top: 6rpx; }

.stats-divider {
  width: 1rpx;
  height: 80rpx;
  background: linear-gradient(180deg, transparent, #e2e8f0, transparent);
  align-self: center;
}

/* 资产配置卡片 - 参考首页设计 */
.asset-allocation-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.allocation-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40rpx;
}

.allocation-pie {
  display: flex;
  justify-content: center;
  flex-shrink: 0;
}

.pie-circle {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.pie-inner {
  position: absolute;
  inset: 36rpx;
  background: white;
  border-radius: 50%;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pie-total {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
  font-family: 'SF Mono', monospace;
}

.allocation-legend {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.allocation-legend .legend-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.allocation-legend .legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.allocation-legend .legend-name {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 500;
}

.allocation-legend .legend-percent {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
  font-family: 'SF Mono', monospace;
}

.allocation-legend .legend-value {
  font-size: 24rpx;
  color: #94a3b8;
  font-family: 'SF Mono', monospace;
}

/* 导航栏按钮样式 */
.nav-btn {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #64748b;
  background: rgba(241, 245, 249, 0.8);
  border-radius: 9999rpx;
}
