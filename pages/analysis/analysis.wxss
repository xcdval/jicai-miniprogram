/* pages/analysis/analysis.wxss - 基于 jicai-fixed.html */

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  background: linear-gradient(90deg, rgba(37, 99, 235, 0.08) 0%, rgba(255, 255, 255, 0.8) 100%);
  font-size: 26rpx;
  font-weight: 500;
  color: #1e293b;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}

.status-time {
  font-weight: 600;
}

.status-dots {
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: rgba(255, 255, 255, 0.85);
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.5);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.nav-title {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
  background: linear-gradient(135deg, #2563eb, #10b981);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.nav-btn {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #64748b;
  background: rgba(241, 245, 249, 0.8);
  border-radius: 9999rpx;
}

/* 持仓健康度评分卡片 */
.health-score-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  margin: 24rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  text-align: center;
}

.health-circle {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 50%, white 55%, rgba(16, 185, 129, 0.3) 56%, rgba(16, 185, 129, 0.1) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.15);
}

.health-score {
  font-size: 72rpx;
  font-weight: 800;
  color: #10b981;
  font-family: 'SF Mono', 'Roboto Mono', monospace;
}

.health-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.health-desc {
  font-size: 24rpx;
  color: #94a3b8;
}

/* 区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  padding: 0 32rpx;
  margin: 32rpx 0 20rpx;
}

/* 分析卡片 */
.analysis-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.analysis-item {
  margin-bottom: 32rpx;
}

.analysis-item:last-child {
  margin-bottom: 0;
}

.analysis-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.analysis-name {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 600;
}

.analysis-level {
  font-size: 28rpx;
  font-weight: 700;
}

.analysis-level.warning {
  color: #f59e0b;
}

.analysis-level.success {
  color: #10b981;
}

.analysis-bar {
  height: 16rpx;
  background: #f1f5f9;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.analysis-progress {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.analysis-tip {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

/* 优化建议卡片 */
.suggestion-card {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(37, 99, 235, 0.04) 100%);
  border: 2rpx solid rgba(16, 185, 129, 0.2);
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
}

.suggestion-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.suggestion-content {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
}

/* 行业分布卡片 */
.industry-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.industry-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.industry-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f8fafc;
}

.industry-item:last-child {
  border-bottom: none;
}

.industry-color {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.industry-name {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
}

.industry-percent {
  font-size: 28rpx;
  font-weight: 700;
  color: #2563eb;
  font-family: 'SF Mono', monospace;
}

/* 主要按钮 */
.btn-primary {
  margin: 48rpx 32rpx;
  padding: 28rpx 48rpx;
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  color: white;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border-radius: 9999rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.25);
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 统计概览卡片 */
.stats-overview-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  margin: 24rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.stats-grid {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 4rpx;
}

.stats-value-container {
  display: flex;
  align-items: baseline;
  justify-content: center;
  font-family: 'DIN Alternate', 'SF Mono', 'Roboto Mono', monospace;
  font-weight: 700;
  gap: 4rpx;
}

.stats-item.positive .stats-value-container { color: #ef4444; }
.stats-item.negative .stats-value-container { color: #10b981; }

.stats-sign { font-size: 24rpx; font-weight: 600; }
.stats-number { font-size: 32rpx; letter-spacing: -0.02em; }
.stats-unit { font-size: 20rpx; font-weight: 600; }
.stats-label { font-size: 20rpx; color: #94a3b8; font-weight: 500; white-space: nowrap; margin-top: 6rpx; }

.stats-divider {
  width: 1rpx;
  height: 80rpx;
  background: linear-gradient(180deg, transparent, #e2e8f0, transparent);
  align-self: center;
}

/* 资产配置卡片 - 参考首页设计 */
.asset-allocation-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.allocation-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40rpx;
}

.allocation-pie {
  display: flex;
  justify-content: center;
  flex-shrink: 0;
}

.pie-circle {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.pie-inner {
  position: absolute;
  inset: 36rpx;
  background: white;
  border-radius: 50%;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pie-total {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
  font-family: 'SF Mono', monospace;
}

.allocation-legend {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.allocation-legend .legend-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.allocation-legend .legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.allocation-legend .legend-name {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 500;
}

.allocation-legend .legend-percent {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
  font-family: 'SF Mono', monospace;
}

.allocation-legend .legend-value {
  font-size: 24rpx;
  color: #94a3b8;
  font-family: 'SF Mono', monospace;
}

/* 导航栏按钮样式 */
.nav-btn {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #64748b;
  background: rgba(241, 245, 249, 0.8);
  border-radius: 9999rpx;
}

.nav-btn.refreshing .refresh-icon {
  animation: rotate 1s linear infinite;
}

/* 分段控制器 */
.segment-control {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.segment-track {
  display: flex;
  position: relative;
  background: #f1f5f9;
  border-radius: 20rpx;
  padding: 6rpx;
}

.segment-slider {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: calc(50% - 6rpx);
  height: calc(100% - 12rpx);
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.segment-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  z-index: 1;
  transition: all 0.3s ease;
}

.segment-icon {
  font-size: 28rpx;
}

.segment-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #64748b;
  transition: color 0.3s ease;
}

.segment-btn.active .segment-text {
  color: #2563eb;
}

/* 视图切换 */
.view-control {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.view-mode-tabs {
  display: flex;
  gap: 16rpx;
}

.view-tab {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #64748b;
  background: #f1f5f9;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.view-tab.active {
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  color: #ffffff;
  font-weight: 600;
}

/* 时间段选择器 */
.time-range-tabs {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.range-tab {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #94a3b8;
  background: transparent;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.range-tab.active {
  color: #2563eb;
  background: rgba(37, 99, 235, 0.1);
}

/* 图表卡片 */
.chart-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.chart-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.chart-subtitle {
  font-size: 24rpx;
  color: #94a3b8;
}

.chart-container {
  height: 300rpx;
  margin: 0 -12rpx;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.legend-text {
  font-size: 24rpx;
  color: #64748b;
}

/* 收益明细卡片 */
.profit-detail-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.detail-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

.detail-info {
  flex: 1;
}

.detail-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.detail-date {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.detail-value-group {
  text-align: right;
}

.detail-value {
  font-size: 28rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', 'SF Mono', monospace;
}

.detail-value.positive { color: #ef4444; }
.detail-value.negative { color: #10b981; }

.detail-percent {
  font-size: 22rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.detail-percent.positive { color: #ef4444; }
.detail-percent.negative { color: #10b981; }

/* 日历卡片 */
.calendar-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.calendar-nav {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #64748b;
  background: #f1f5f9;
  border-radius: 16rpx;
}

.calendar-nav.disabled {
  opacity: 0.4;
}

.calendar-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.period-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.period-tab {
  flex: 1;
  padding: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #64748b;
  background: #f8fafc;
  border-radius: 12rpx;
}

.period-tab.active {
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  color: #ffffff;
  font-weight: 600;
}

.calendar-weekday-row {
  display: flex;
  margin-bottom: 12rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 600;
}

.calendar-day-row {
  display: flex;
}

.calendar-day-cell {
  flex: 1;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  margin: 2rpx;
}

.calendar-day-cell.empty {
  background: transparent;
}

.calendar-day-cell.today {
  background: rgba(37, 99, 235, 0.1);
}

.day-num {
  font-size: 24rpx;
  color: #1e293b;
  font-weight: 500;
}

.day-profit {
  font-size: 18rpx;
  font-weight: 600;
  margin-top: 4rpx;
  font-family: 'DIN Alternate', monospace;
}

.day-profit.up { color: #ef4444; }
.day-profit.down { color: #10b981; }

/* 年视图 */
.year-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.year-month-cell {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
}

.year-month-cell.current {
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(16, 185, 129, 0.1));
  border: 2rpx solid var(--color-primary);
}

.year-month-label {
  font-size: 24rpx;
  color: #64748b;
  display: block;
}

.year-month-value {
  font-size: 26rpx;
  font-weight: 700;
  display: block;
  margin-top: 8rpx;
  font-family: 'DIN Alternate', monospace;
}

.year-month-value.up { color: #ef4444; }
.year-month-value.down { color: #10b981; }

/* 多年视图 */
.years-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.years-year-cell {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}

.years-year-cell.current {
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(16, 185, 129, 0.1));
  border: 2rpx solid var(--color-primary);
}

.years-year-label {
  font-size: 26rpx;
  color: #64748b;
  display: block;
}

.years-year-value {
  font-size: 30rpx;
  font-weight: 700;
  display: block;
  margin-top: 8rpx;
  font-family: 'DIN Alternate', monospace;
}

.years-year-value.up { color: #ef4444; }
.years-year-value.down { color: #10b981; }

.calendar-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.display-toggle {
  display: flex;
  align-items: center;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 4rpx;
}

.toggle-btn {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #94a3b8;
  border-radius: 8rpx;
}

.toggle-btn.active {
  background: #ffffff;
  color: #2563eb;
  font-weight: 600;
}

.toggle-divider {
  color: #e2e8f0;
}

/* 收益排行卡片 */
.rank-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f8fafc;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-number {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

.rank-info {
  flex: 1;
}

.rank-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
}

.rank-type {
  font-size: 22rpx;
  color: #94a3b8;
}

.rank-profit {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.rank-profit.positive { background: rgba(239, 68, 68, 0.1); }
.rank-profit.negative { background: rgba(16, 185, 129, 0.1); }

.rank-profit-value {
  font-size: 26rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', monospace;
}

.rank-profit.positive .rank-profit-value { color: #ef4444; }
.rank-profit.negative .rank-profit-value { color: #10b981; }

/* 日期详情弹窗 */
.day-detail-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.day-detail-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin: 0 64rpx;
  width: 100%;
  max-width: 600rpx;
}

.day-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.day-detail-date {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.day-detail-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #94a3b8;
  background: #f1f5f9;
  border-radius: 50%;
}

.day-detail-content {
  display: flex;
  gap: 32rpx;
}

.day-detail-item {
  flex: 1;
  text-align: center;
}

