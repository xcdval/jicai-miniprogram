<view class="container">
  <!-- 状态栏 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;">
    <text class="status-time">9:41</text>
    <text class="status-dots">●●●</text>
  </view>

  <!-- 导航栏 -->
  <view class="nav-bar" style="height: {{navBarHeight}}px;">
    <view class="nav-btn" style="visibility: hidden;">‹</view>
    <view class="nav-title">我的</view>
    <view class="nav-btn" bindtap="showSettings">⚙</view>
  </view>

  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-avatar">👤</view>
    <view class="user-info">
      <view class="user-name">{{userInfo.name}}</view>
      <view class="user-level">普通会员 · 已使用 {{usageDays}} 天</view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="section-title">功能菜单</view>
  <view class="menu-card">
    <view class="menu-item" bindtap="navigateTo" data-page="messages">
      <view class="menu-left">
        <view class="menu-icon">💬</view>
        <text class="menu-text">消息中心</text>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="navigateTo" data-page="statistics">
      <view class="menu-left">
        <view class="menu-icon">📊</view>
        <text class="menu-text">资产统计</text>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="navigateTo" data-page="strategy">
      <view class="menu-left">
        <view class="menu-icon">🎯</view>
        <text class="menu-text">投资策略</text>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="navigateTo" data-page="settings">
      <view class="menu-left">
        <view class="menu-icon">⚙️</view>
        <text class="menu-text">设置</text>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <!-- 数据概览 -->
  <view class="section-title">数据概览</view>
  <view class="stats-card">
    <view class="stats-grid">
      <view class="stats-item">
        <view class="stats-value stats-primary">{{assetCount}}</view>
        <view class="stats-label">总资产数</view>
      </view>
      <view class="stats-item">
        <view class="stats-value stats-success">{{platformCount}}</view>
        <view class="stats-label">持仓平台</view>
      </view>
      <view class="stats-item">
        <view class="stats-value stats-warning">{{healthScore}}</view>
        <view class="stats-label">健康评分</view>
      </view>
      <view class="stats-item">
        <view class="stats-value stats-info">{{reminderCount}}</view>
        <view class="stats-label">提醒事项</view>
      </view>
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="section-title">数据管理</view>
  <view class="menu-card">
    <view class="menu-item" bindtap="exportData">
      <view class="menu-left">
        <view class="menu-icon">📤</view>
        <text class="menu-text">导出数据</text>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="importData">
      <view class="menu-left">
        <view class="menu-icon">📥</view>
        <text class="menu-text">导入数据</text>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="showStorageInfo">
      <view class="menu-left">
        <view class="menu-icon">💾</view>
        <text class="menu-text">存储空间</text>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="clearData">
      <view class="menu-left">
        <view class="menu-icon">🗑️</view>
        <text class="menu-text text-danger">清空数据</text>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <!-- 偏好设置 -->
  <view class="section-title">偏好设置</view>
  <view class="menu-card">
    <view class="menu-item" bindtap="toggleAmount">
      <view class="menu-left">
        <view class="menu-icon">👁️</view>
        <text class="menu-text">显示金额</text>
      </view>
      <switch class="menu-switch" checked="{{showAmount}}" bindchange="toggleAmount"/>
    </view>
    <view class="menu-item" bindtap="showToast">
      <view class="menu-left">
        <view class="menu-icon">🌙</view>
        <text class="menu-text">深色模式</text>
      </view>
      <switch class="menu-switch" checked="{{darkMode}}"/>
    </view>
  </view>

  <!-- AI 设置 -->
  <view class="section-title">AI 智能决策设置</view>
  <view class="ai-config-card">
    <view class="config-row">
      <text class="config-label">启用 AI 分析</text>
      <switch checked="{{deepseekUseAI}}" bindchange="onUseAIToggle"/>
    </view>
    <view class="config-row">
      <text class="config-label">API Key</text>
      <view class="api-key-input-row">
        <input class="config-input" password="{{!showApiKey}}" value="{{deepseekApiKey}}" bindinput="onApiKeyInput" placeholder="sk-xxxxxxxx"/>
        <view class="show-key-btn" bindtap="toggleShowApiKey">{{showApiKey ? '隐藏' : '显示'}}</view>
      </view>
    </view>
    <view class="config-row">
      <text class="config-label">模型</text>
      <input class="config-input" value="{{deepseekModel}}" bindinput="onModelInput" placeholder="deepseek-chat"/>
    </view>
    <view class="save-btn" bindtap="saveDeepseekConfig">保存配置</view>
  </view>

  <!-- OCR 设置 -->
  <view class="section-title">OCR 识别设置</view>
  <view class="ai-config-card">
    <view class="config-row">
      <text class="config-label">启用腾讯云 OCR</text>
      <switch checked="{{ocrUseCloud}}" bindchange="onOcrUseCloudToggle"/>
    </view>
    <view class="config-row">
      <text class="config-label">SecretId</text>
      <input class="config-input" value="{{ocrSecretId}}" bindinput="onOcrSecretIdInput" placeholder="AKID..."/>
    </view>
    <view class="config-row">
      <text class="config-label">SecretKey</text>
      <view class="api-key-input-row">
        <input class="config-input" password="{{!showOcrSecretKey}}" value="{{ocrSecretKey}}" bindinput="onOcrSecretKeyInput" placeholder="..."/>
        <view class="show-key-btn" bindtap="toggleShowOcrSecretKey">{{showOcrSecretKey ? '隐藏' : '显示'}}</view>
      </view>
    </view>
    <view class="save-btn" bindtap="saveOcrConfig">保存配置</view>
  </view>

  <!-- 关于 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="showToast">
      <view class="menu-left">
        <view class="menu-icon">❓</view>
        <text class="menu-text">帮助中心</text>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="showToast">
      <view class="menu-left">
        <view class="menu-icon">⭐</view>
        <text class="menu-text">给个好评</text>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="showToast">
      <view class="menu-left">
        <view class="menu-icon">ℹ️</view>
        <text class="menu-text">关于</text>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="btn-logout" bindtap="logout">退出登录</view>

  <view class="version">v{{version}}</view>
</view>
<tab-bar activeIndex="4"></tab-bar>