/* pages/profile/profile.wxss */
.nav-bar { display: flex; justify-content: center; align-items: center; padding: 0 32rpx; margin-bottom: 16rpx; }
.nav-title { font-size: 40rpx; font-weight: 700; color: #1e293b; }

.user-card { display: flex; align-items: center; gap: 24rpx; padding: 32rpx; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); border-radius: 32rpx; margin: 0 32rpx 24rpx; box-shadow: 0 8rpx 32rpx rgba(37,99,235,0.25); color: white; }
.user-avatar { width: 96rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.2); border-radius: 50%; font-size: 48rpx; }
.user-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.user-name { font-size: 36rpx; font-weight: 700; }
.user-id { font-size: 24rpx; opacity: 0.8; }
.user-arrow { font-size: 48rpx; opacity: 0.8; }

.menu-card { background: white; border-radius: 24rpx; margin: 0 32rpx 24rpx; overflow: hidden; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.menu-item { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 32rpx; border-bottom: 1rpx solid #f1f5f9; }
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 36rpx; width: 48rpx; text-align: center; }
.menu-text { flex: 1; font-size: 28rpx; color: #1e293b; }
.menu-arrow { font-size: 32rpx; color: #94a3b8; }
.menu-switch { transform: scale(0.8); }

.version { text-align: center; font-size: 24rpx; color: #94a3b8; margin-top: 48rpx; }