<view class="container">
  <!-- 状态栏 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;">
    <text class="status-time">9:41</text>
    <text class="status-dots">●●●</text>
  </view>

  <!-- 导航栏 -->
  <view class="nav-bar" style="height: {{navBarHeight}}px;">
    <view class="nav-btn" style="visibility: hidden;">‹</view>
    <view class="nav-title">市场情报</view>
    <view class="nav-btn" bindtap="refreshData">↻</view>
  </view>

  <!-- 时段切换标签 -->
  <view class="intelligence-tabs-card">
    <view class="intelligence-tabs">
      <view class="intelligence-tab {{activePhase === 'morning' ? 'active' : ''}}" data-phase="morning" bindtap="switchPhase">
        <view class="tab-icon-small">🌅</view>
        <view class="tab-content">
          <view class="tab-title">早盘情报</view>
          <view class="tab-time">09:15前</view>
        </view>
      </view>
      <view class="intelligence-tab {{activePhase === 'intraday' ? 'active' : ''}}" data-phase="intraday" bindtap="switchPhase">
        <view class="tab-icon-small">☀️</view>
        <view class="tab-content">
          <view class="tab-title">盘中分析</view>
          <view class="tab-time">09:30-15:00</view>
        </view>
      </view>
      <view class="intelligence-tab {{activePhase === 'closing' ? 'active' : ''}}" data-phase="closing" bindtap="switchPhase">
        <view class="tab-icon-small">🌙</view>
        <view class="tab-content">
          <view class="tab-title">盘后复盘</view>
          <view class="tab-time">15:00后</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 早盘情报内容 -->
  <view wx:if="{{activePhase === 'morning'}}">
    <!-- AI决策仪表盘 -->
    <view class="ai-dashboard">
      <view class="ai-dashboard-header">
        <view class="ai-badge">AI 智能决策</view>
        <view class="ai-update-time">基于多维度数据分析</view>
      </view>
      <view class="ai-conclusion">
        今日市场情绪偏乐观，降准释放流动性利好，建议逢低布局新能源与AI算力板块，仓位控制在60-70%
      </view>
      <view class="ai-signals">
        <view class="signal-item">
          <view class="signal-label">大盘方向</view>
          <view class="signal-value signal-buy">看多 ↑</view>
        </view>
        <view class="signal-item">
          <view class="signal-label">操作建议</view>
          <view class="signal-value signal-hold">逢低买入</view>
        </view>
        <view class="signal-item">
          <view class="signal-label">目标仓位</view>
          <view class="signal-value">60-70%</view>
        </view>
      </view>
      <view class="ai-checklist">
        <view class="checklist-title">📋 操作 checklist</view>
        <view class="checklist-item checked">关注北向资金流向</view>
        <view class="checklist-item checked">监控成交量变化</view>
        <view class="checklist-item">观察3300点支撑位</view>
        <view class="checklist-item">止盈涨幅超5%个股</view>
      </view>
    </view>

    <!-- 全球市场概览 -->
    <view class="global-markets-card">
      <view class="card-header-row">
        <text class="card-title-text">🌍 全球市场概览</text>
        <text class="card-update-time">实时更新</text>
      </view>
      <view class="global-markets">
        <view class="market-mini">
          <view class="market-name">道琼斯</view>
          <view class="market-index">38,567.52</view>
          <view class="market-change-mini rise">+0.56% ↑</view>
        </view>
        <view class="market-mini">
          <view class="market-name">纳斯达克</view>
          <view class="market-index">15,888.32</view>
          <view class="market-change-mini rise">+1.24% ↑</view>
        </view>
        <view class="market-mini">
          <view class="market-name">标普500</view>
          <view class="market-index">5,026.12</view>
          <view class="market-change-mini rise">+0.89% ↑</view>
        </view>
        <view class="market-mini">
          <view class="market-name">恒生指数</view>
          <view class="market-index">16,789.45</view>
          <view class="market-change-mini fall">-0.32% ↓</view>
        </view>
        <view class="market-mini">
          <view class="market-name">富时A50</view>
          <view class="market-index">11,892.35</view>
          <view class="market-change-mini rise">+0.45% ↑</view>
        </view>
        <view class="market-mini">
          <view class="market-name">日经225</view>
          <view class="market-index">38,456.12</view>
          <view class="market-change-mini rise">+0.78% ↑</view>
        </view>
      </view>
      <view class="data-sources">
        <text class="source-tag">Yahoo Finance</text>
        <text class="source-tag">Bloomberg</text>
        <text class="source-tag">东方财富</text>
      </view>
    </view>

    <!-- 市场情绪仪表盘 -->
    <view class="sentiment-gauge">
      <view class="gauge-header">
        <view class="gauge-title">📊 市场情绪指数</view>
        <view class="gauge-value gauge-greed">72 - 贪婪</view>
      </view>
      <view class="gauge-bar">
        <view class="gauge-marker" style="left: 72%;"></view>
      </view>
      <view class="gauge-labels">
        <text>极度恐惧</text>
        <text>恐惧</text>
        <text>中性</text>
        <text>贪婪</text>
        <text>极度贪婪</text>
      </view>
      <view class="sentiment-factors">
        <view class="factor-item">
          <text class="factor-name">波动率</text>
          <text class="factor-value fall">-12% ↓</text>
        </view>
        <view class="factor-item">
          <text class="factor-name">涨跌比</text>
          <text class="factor-value rise">2.8 ↑</text>
        </view>
        <view class="factor-item">
          <text class="factor-name">北向资金</text>
          <text class="factor-value rise">+86.5亿 ↑</text>
        </view>
        <view class="factor-item">
          <text class="factor-name">期权PCR</text>
          <text class="factor-value rise">0.82 ↑</text>
        </view>
      </view>
    </view>

    <!-- 市场开盘倒计时 -->
    <view class="flash-header">
      <view class="flash-live-indicator">
        <view class="live-dot"></view>
        <text class="live-text">实时快讯</text>
      </view>
      <view class="flash-countdown">
        <text>距开盘</text>
        <text class="countdown-time">00:42:18</text>
      </view>
    </view>

    <!-- 置顶重要信息 -->
    <view class="flash-pin">
      <view class="pin-tag">置顶</view>
      <view class="pin-content">
        <view class="pin-title">央行超预期降准0.5个百分点，释放流动性约1万亿</view>
        <view class="pin-meta">
          <text class="tag tag-policy">政策</text>
          <text class="time">07:32</text>
        </view>
      </view>
    </view>

    <!-- 资金流向 -->
    <view class="fund-flow-section">
      <view class="flow-header">
        <view class="flow-title">💰 资金流向</view>
        <view class="flow-subtitle">实时主力净流入</view>
      </view>
      <view class="flow-grid">
        <view class="flow-item">
          <view class="flow-label">北向资金</view>
          <view class="flow-amount flow-in">+86.5亿 ↑</view>
        </view>
        <view class="flow-item">
          <view class="flow-label">主力资金</view>
          <view class="flow-amount flow-in">+52.3亿 ↑</view>
        </view>
        <view class="flow-item">
          <view class="flow-label">散户资金</view>
          <view class="flow-amount flow-out">-28.7亿 ↓</view>
        </view>
        <view class="flow-item">
          <view class="flow-label">融资余额</view>
          <view class="flow-amount flow-in">+125.6亿 ↑</view>
        </view>
      </view>
    </view>

    <!-- 分类信息展示 -->
    <view class="section-title">分类资讯</view>
    <view class="category-grid">
      <view class="category-card" wx:for="{{categoryNews}}" wx:key="type">
        <view class="category-header">
          <view class="category-icon">{{item.icon}}</view>
          <view class="category-title">{{item.title}}</view>
          <view class="category-count">{{item.count}}条</view>
        </view>
        <view class="category-content">
          <view class="category-news-item" wx:for="{{item.news}}" wx:for-item="newsItem" wx:key="id">
            <view class="news-item-title">{{newsItem.title}}</view>
            <view class="news-item-meta" wx:if="{{newsItem.detail}}">
              <text class="market-change {{newsItem.detailType}}">{{newsItem.detail}}</text>
            </view>
            <view class="news-item-time">{{newsItem.time}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 盘中分析内容 -->
  <view wx:if="{{activePhase === 'intraday'}}">
    <view class="flash-header">
      <view class="flash-live-indicator">
        <view class="live-dot"></view>
        <text class="live-text">盘中快讯</text>
      </view>
      <view class="flash-countdown">
        <text>距收盘</text>
        <text class="countdown-time">02:18:42</text>
      </view>
    </view>

    <view class="flash-pin">
      <view class="pin-tag">重要</view>
      <view class="pin-content">
        <view class="pin-title">市场情绪指数升至72点，进入贪婪区间，光伏板块领涨</view>
        <view class="pin-meta">
          <text class="tag tag-market">市场</text>
          <text class="time">11:45</text>
        </view>
      </view>
    </view>

    <view class="section-title">实时资讯</view>
    <news-flash newsList="{{newsFlash}}"></news-flash>
  </view>

  <!-- 盘后复盘内容 -->
  <view wx:if="{{activePhase === 'closing'}}">
    <view class="flash-header">
      <view class="flash-live-indicator">
        <view class="live-dot" style="background: #10b981;"></view>
        <text class="live-text">盘后复盘</text>
      </view>
      <view class="flash-countdown">
        <text>今日收盘</text>
        <text class="countdown-time">已收盘</text>
      </view>
    </view>

    <view class="closing-summary-card">
      <view class="summary-title">📈 今日市场总结</view>
      <view class="summary-content">
        <view class="summary-item">
          <text class="summary-label">上证指数</text>
          <text class="summary-value rise">3,245.68 +0.54%</text>
        </view>
        <view class="summary-item">
          <text class="summary-label">深证成指</text>
          <text class="summary-value rise">10,456.32 +0.78%</text>
        </view>
        <view class="summary-item">
          <text class="summary-label">创业板指</text>
          <text class="summary-value rise">2,156.88 +1.12%</text>
        </view>
        <view class="summary-item">
          <text class="summary-label">成交额</text>
          <text class="summary-value">8,956亿</text>
        </view>
      </view>
    </view>

    <view class="section-title">涨跌分布</view>
    <view class="up-down-stats">
      <view class="up-down-bar">
        <view class="up-segment" style="width: 65%;"></view>
        <view class="down-segment" style="width: 35%;"></view>
      </view>
      <view class="up-down-labels">
        <text class="up-label">上涨 3256只</text>
        <text class="down-label">下跌 1568只</text>
      </view>
    </view>

    <view class="section-title">龙虎榜</view>
    <view class="dragon-tiger-list">
      <view class="dt-item" wx:for="{{dragonTigerList}}" wx:key="name">
        <view class="dt-rank">{{index + 1}}</view>
        <view class="dt-info">
          <view class="dt-name">{{item.name}}</view>
          <view class="dt-reason">{{item.reason}}</view>
        </view>
        <view class="dt-change {{item.change > 0 ? 'rise' : 'fall'}}">
          {{item.change > 0 ? '+' : ''}}{{item.change}}%
        </view>
      </view>
    </view>
  </view>
</view>
<tab-bar activeIndex="2"></tab-bar>
