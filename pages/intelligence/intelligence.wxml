<view class="container">
  <!-- 状态栏 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;">
    <text class="status-time">{{lastUpdate}}</text>
    <text class="status-dots">●●●</text>
  </view>

  <!-- 导航栏 -->
  <view class="nav-bar" style="height: {{navBarHeight}}px;">
    <view class="nav-btn" style="visibility: hidden;">‹</view>
    <view class="nav-title">市场情报</view>
    <view class="nav-btn refresh-btn {{isRefreshing ? 'refreshing' : ''}}" bindtap="onRefreshTap">
      <text class="refresh-icon">↻</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="loading-overlay">
    <text>加载中...</text>
  </view>

  <!-- 非开盘日提示 -->
  <view wx:if="{{!isTradingDay}}" class="holiday-banner">
    <text class="holiday-icon">📅</text>
    <text class="holiday-text">今日非开盘日</text>
    <text class="holiday-date" wx:if="{{lastTradingDay}}">上次复盘：{{lastTradingDay}}</text>
  </view>

  <!-- 当前时段指示器 -->
  <view class="phase-indicator" wx:if="{{isTradingDay}}">
    <text class="phase-icon">{{activePhase === 'morning' ? '🌅' : activePhase === 'intraday' ? '☀️' : '🌙'}}</text>
    <text class="phase-text">{{activePhase === 'morning' ? '早盘情报' : activePhase === 'intraday' ? '盘中分析' : '盘后复盘'}}</text>
    <text class="phase-time-hint">{{activePhase === 'morning' ? '09:15前' : activePhase === 'intraday' ? '09:30-15:00' : '15:00后'}}</text>
  </view>

  <!-- ==================== 早盘情报 - 预判为主 ==================== -->
  <view wx:if="{{activePhase === 'morning'}}">
    <!-- AI决策仪表盘 - 早盘核心 -->
    <view class="ai-dashboard">
      <view class="ai-dashboard-header">
        <view class="ai-badge">AI 智能决策</view>
        <view class="ai-update-time">开盘前预判</view>
      </view>
      <view class="ai-conclusion">{{aiData.conclusion || '数据加载中...'}}</view>
      <view class="ai-signals">
        <view class="signal-item">
          <view class="signal-label">大盘方向</view>
          <view class="signal-value {{aiData.direction === '看多' ? 'signal-buy' : aiData.direction === '看空' ? 'signal-sell' : 'signal-hold'}}">{{aiData.direction || '--'}} {{aiData.direction === '看多' ? '↑' : aiData.direction === '看空' ? '↓' : '→'}}</view>
        </view>
        <view class="signal-item">
          <view class="signal-label">操作建议</view>
          <view class="signal-value signal-hold">{{aiData.suggestion || '--'}}</view>
        </view>
        <view class="signal-item">
          <view class="signal-label">建议仓位</view>
          <view class="signal-value">{{aiData.targetPosition || '--'}}</view>
        </view>
      </view>
      <view class="ai-risk-warning" wx:if="{{aiData.riskWarning}}">
        <text class="risk-icon">!</text>
        <text class="risk-text">{{aiData.riskWarning}}</text>
      </view>
      <view class="ai-key-levels" wx:if="{{aiData.keyLevels}}">
        <view class="level-item">
          <text class="level-label">支撑位</text>
          <text class="level-value support">{{aiData.keyLevels.support || '--'}}</text>
        </view>
        <view class="level-item">
          <text class="level-label">压力位</text>
          <text class="level-value resistance">{{aiData.keyLevels.resistance || '--'}}</text>
        </view>
      </view>
    </view>

    <!-- 行业板块涨幅榜 -->
    <view class="sector-performance-card" wx:if="{{sectorPerformance.industrySectors.length > 0}}">
      <view class="sector-card-header">
        <text class="sector-card-title">行业板块涨幅榜</text>
      </view>
      <view class="sector-list">
        <view class="sector-item" wx:for="{{sectorPerformance.industrySectors}}" wx:key="code">
          <text class="sector-name">{{item.name}}</text>
          <text class="sector-change {{item.changePercent >= 0 ? 'up' : 'down'}}">{{item.changePercent >= 0 ? '+' : ''}}{{item.changePercent}}%</text>
        </view>
      </view>
    </view>

    <!-- AI推荐关注板块 -->
    <view class="hot-sectors-card" wx:if="{{aiData.hotSectors && aiData.hotSectors.length > 0}}">
      <view class="hot-card-header">
        <text class="hot-card-title">AI推荐关注板块</text>
      </view>
      <view class="hot-tags">
        <view class="hot-tag" wx:for="{{aiData.hotSectors}}" wx:key="index">{{item}}</view>
      </view>
    </view>

    <!-- 全球市场概览 -->
    <view class="global-markets-card">
      <view class="card-header-row">
        <text class="card-title-text">全球市场概览</text>
        <text class="card-update-time">实时更新</text>
      </view>
      <view class="global-markets">
        <view class="market-mini" wx:for="{{globalIndices}}" wx:key="code">
          <view class="market-name">{{item.name}}</view>
          <view class="market-index">{{item.current}}</view>
          <view class="market-change-mini {{item.changePercent >= 0 ? 'rise' : 'fall'}}">{{item.changePercent}}%</view>
        </view>
      </view>
    </view>

    <!-- 操作checklist -->
    <view class="ai-checklist-card" wx:if="{{aiData.checklist && aiData.checklist.length > 0}}">
      <view class="checklist-title">今日操作 checklist</view>
      <view class="checklist-item {{item.done ? 'checked' : ''}}" wx:for="{{aiData.checklist}}" wx:key="text">{{item.text}}</view>
    </view>
  </view>

  <!-- ==================== 盘中分析 - 实时监控 ==================== -->
  <view wx:if="{{activePhase === 'intraday'}}">
    <!-- 实时行情概览 -->
    <view class="ai-dashboard">
      <view class="ai-dashboard-header">
        <view class="ai-badge">盘中实时</view>
        <view class="ai-update-time">数据实时更新</view>
      </view>
      <view class="ai-conclusion">{{aiData.conclusion || '盘中分析中...'}}</view>
      <view class="ai-signals">
        <view class="signal-item">
          <view class="signal-label">当前态势</view>
          <view class="signal-value">{{sentiment.level || '分析中'}}</view>
        </view>
        <view class="signal-item">
          <view class="signal-label">操作建议</view>
          <view class="signal-value signal-hold">{{aiData.suggestion || '观望'}}</view>
        </view>
        <view class="signal-item">
          <view class="signal-label">市场情绪</view>
          <view class="signal-value {{sentiment.value >= 50 ? 'signal-buy' : 'signal-sell'}}">{{sentiment.value || '--'}}</view>
        </view>
      </view>
    </view>

    <!-- 今日概况 -->
    <view class="closing-summary-card">
      <view class="summary-header">
        <text class="summary-title">今日概况</text>
      </view>
      <view class="summary-grid">
        <view class="summary-col">
          <view class="summary-label">上涨</view>
          <view class="summary-value rise">{{upCount || 0}}只</view>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-col">
          <view class="summary-label">下跌</view>
          <view class="summary-value fall">{{downCount || 0}}只</view>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-col">
          <view class="summary-label">涨跌比</view>
          <view class="summary-value {{upDownRatio >= 50 ? 'rise' : 'fall'}}">{{upDownRatio || 50}}%</view>
        </view>
      </view>
    </view>

    <!-- 市场情绪 -->
    <view class="sentiment-gauge">
      <view class="gauge-header">
        <view class="gauge-title">盘中情绪</view>
        <view class="gauge-value {{sentiment.value >= 60 ? 'gauge-greed' : 'gauge-fear'}}">{{sentiment.value || 50}} - {{sentiment.level || '中性'}}</view>
      </view>
      <view class="gauge-bar">
        <view class="gauge-marker" style="left: {{sentiment.value || 50}}%;"></view>
      </view>
      <view class="gauge-labels">
        <text>极度恐惧</text>
        <text>恐惧</text>
        <text>中性</text>
        <text>贪婪</text>
        <text>极度贪婪</text>
      </view>
    </view>

    <!-- 资金动向 -->
    <view class="fund-flow-section">
      <view class="flow-header">
        <view class="flow-title">资金动向</view>
        <view class="flow-subtitle">实时资金流向</view>
      </view>
      <view class="flow-grid">
        <view class="flow-item">
          <view class="flow-label">北向资金</view>
          <view class="flow-amount {{fundFlow.northFlow >= 0 ? 'flow-in' : 'flow-out'}}">{{fundFlow.northFlow >= 0 ? '+' : ''}}{{fundFlow.northFlow || 0}}亿</view>
        </view>
        <view class="flow-item">
          <view class="flow-label">主力资金</view>
          <view class="flow-amount {{fundFlow.mainFlow >= 0 ? 'flow-in' : 'flow-out'}}">{{fundFlow.mainFlow >= 0 ? '+' : ''}}{{fundFlow.mainFlow || 0}}亿</view>
        </view>
      </view>
    </view>

    <!-- 盘中快讯 -->
    <view class="section-title">盘中快讯</view>
    <news-flash newsList="{{newsFlash}}"></news-flash>
  </view>

  <!-- ==================== 盘后复盘 - 总结为主 ==================== -->
  <view wx:if="{{activePhase === 'closing'}}">
    <!-- AI复盘建议 -->
    <view class="ai-dashboard" wx:if="{{aiData.conclusion}}">
      <view class="ai-dashboard-header">
        <view class="ai-badge">AI 复盘</view>
        <view class="ai-update-time">盘后智能总结</view>
      </view>
      <view class="ai-conclusion">{{aiData.conclusion}}</view>
      <view class="ai-signals">
        <view class="signal-item">
          <view class="signal-label">明日方向</view>
          <view class="signal-value {{aiData.direction === '看多' ? 'signal-buy' : aiData.direction === '看空' ? 'signal-sell' : 'signal-hold'}}">{{aiData.direction || '观望'}} {{aiData.direction === '看多' ? '↑' : aiData.direction === '看空' ? '↓' : '→'}}</view>
        </view>
        <view class="signal-item">
          <view class="signal-label">操作建议</view>
          <view class="signal-value signal-hold">{{aiData.suggestion || '观望'}}</view>
        </view>
        <view class="signal-item">
          <view class="signal-label">建议仓位</view>
          <view class="signal-value">{{aiData.targetPosition || '50%'}}</view>
        </view>
      </view>
      <view class="ai-risk-warning" wx:if="{{aiData.riskWarning}}">
        <text class="risk-icon">!</text>
        <text class="risk-text">{{aiData.riskWarning}}</text>
      </view>
    </view>

    <!-- 今日概况 -->
    <view class="closing-summary-card">
      <view class="summary-header">
        <text class="summary-title">今日概况</text>
      </view>
      <view class="summary-grid">
        <view class="summary-col">
          <view class="summary-label">上涨</view>
          <view class="summary-value rise">{{upCount || 0}}只</view>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-col">
          <view class="summary-label">下跌</view>
          <view class="summary-value fall">{{downCount || 0}}只</view>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-col">
          <view class="summary-label">涨跌比</view>
          <view class="summary-value {{upDownRatio >= 50 ? 'rise' : 'fall'}}">{{upDownRatio || 50}}%</view>
        </view>
      </view>
      <view class="volume-row" wx:if="{{totalVolumeFormatted}}">
        <text class="volume-label">成交额</text>
        <text class="volume-value">{{totalVolumeFormatted}}</text>
      </view>
      <view class="updown-bar-container">
        <view class="updown-bar">
          <view class="updown-up" style="width: {{upDownRatio || 50}}%;"></view>
          <view class="updown-down" style="width: {{100 - (upDownRatio || 50)}}%;"></view>
        </view>
      </view>
    </view>

    <!-- 收盘情绪 -->
    <view class="sentiment-gauge">
      <view class="gauge-header">
        <view class="gauge-title">收盘情绪</view>
        <view class="gauge-value {{sentiment.value >= 60 ? 'gauge-greed' : 'gauge-fear'}}">{{sentiment.value || 50}} - {{sentiment.level || '中性'}}</view>
      </view>
      <view class="gauge-bar">
        <view class="gauge-marker" style="left: {{sentiment.value || 50}}%;"></view>
      </view>
      <view class="gauge-labels">
        <text>极度恐惧</text>
        <text>恐惧</text>
        <text>中性</text>
        <text>贪婪</text>
        <text>极度贪婪</text>
      </view>
    </view>

    <!-- 龙虎榜 -->
    <view class="closing-section">
      <view class="section-header">
        <text class="section-title">龙虎榜</text>
        <text class="section-count">{{dragonTigerList.length || 0}}只</text>
      </view>
      <view class="dragon-tiger-list">
        <view class="dt-item" wx:if="{{dragonTigerList.length > 0}}" wx:for="{{dragonTigerList}}" wx:key="code">
          <view class="dt-rank">{{index + 1}}</view>
          <view class="dt-info">
            <view class="dt-name">{{item.name}}</view>
            <view class="dt-reason">{{item.reason}}</view>
          </view>
          <view class="dt-change {{item.change >= 0 ? 'rise' : 'fall'}}">
            {{item.change >= 0 ? '+' : ''}}{{item.change}}%
          </view>
        </view>
        <view class="dt-empty" wx:if="{{dragonTigerList.length === 0}}">
          <text>暂无龙虎榜数据</text>
        </view>
      </view>
    </view>
  </view>
</view>
<tab-bar activeIndex="2"></tab-bar>