/* pages/intelligence/intelligence.wxss */
.nav-bar { display: flex; justify-content: center; align-items: center; padding: 0 32rpx; margin-bottom: 16rpx; }
.nav-title { font-size: 40rpx; font-weight: 700; color: #1e293b; }

.phase-tabs { display: flex; gap: 20rpx; padding: 0 32rpx; margin-bottom: 24rpx; }
.phase-tab { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 24rpx; background: #f1f5f9; border-radius: 24rpx; transition: all 0.3s ease; }
.phase-tab.active { background: linear-gradient(135deg, #2563eb, #1d4ed8); color: white; }
.phase-icon { font-size: 40rpx; }
.phase-tab text:last-child { font-size: 26rpx; font-weight: 600; }

.ai-dashboard { background: linear-gradient(135deg, #1e293b 0%, #334155 100%); border-radius: 32rpx; padding: 32rpx; margin: 0 32rpx 24rpx; color: white; }
.ai-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.ai-title { font-size: 32rpx; font-weight: 700; }
.ai-confidence { font-size: 24rpx; padding: 8rpx 16rpx; background: rgba(255,255,255,0.15); border-radius: 9999rpx; }

.ai-signal { display: flex; justify-content: center; margin-bottom: 24rpx; }
.signal-badge { padding: 16rpx 48rpx; border-radius: 9999rpx; font-size: 32rpx; font-weight: 700; }
.signal-badge.BULL { background: linear-gradient(135deg, #ef4444, #dc2626); }
.signal-badge.BEAR { background: linear-gradient(135deg, #10b981, #059669); }
.signal-badge.NEUTRAL { background: linear-gradient(135deg, #f59e0b, #d97706); }

.ai-signals-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; margin-bottom: 24rpx; }
.signal-item { display: flex; flex-direction: column; gap: 8rpx; padding: 20rpx; background: rgba(255,255,255,0.1); border-radius: 16rpx; }
.signal-label { font-size: 22rpx; opacity: 0.7; }
.signal-value { font-size: 28rpx; font-weight: 600; }
.signal-value.bull { color: #fca5a5; }
.signal-value.bear { color: #86efac; }

.ai-summary { font-size: 26rpx; line-height: 1.6; opacity: 0.9; margin-bottom: 24rpx; padding: 20rpx; background: rgba(255,255,255,0.05); border-radius: 16rpx; }

.ai-checklist { border-top: 1rpx solid rgba(255,255,255,0.1); padding-top: 24rpx; }
.checklist-title { font-size: 26rpx; font-weight: 600; margin-bottom: 16rpx; }
.checklist-item { display: flex; align-items: flex-start; gap: 12rpx; margin-bottom: 12rpx; }
.checklist-checkbox { font-size: 28rpx; opacity: 0.7; }
.checklist-checkbox.checked { opacity: 1; color: #86efac; }
.checklist-text { font-size: 24rpx; line-height: 1.5; opacity: 0.9; flex: 1; }